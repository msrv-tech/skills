{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/1c-ui-scenario.schema.json",
  "title": "CodexTestBridge native UI scenario",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string"},
    "navigationLink": {"type": "string", "minLength": 1},
    "dismissStartupDialogs": {"type": "boolean", "default": true},
    "startupDialogAttempts": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5},
    "startupDialogButtons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "restartTestClientOnStartup": {"type": "boolean", "default": false},
    "closeTestClientOnFinish": {"type": "boolean", "default": true},
    "startupSettleSeconds": {"type": "integer", "minimum": 0, "maximum": 60, "default": 3},
    "uiaBeforeSteps": {"type": "array", "items": {"type": "object"}},
    "uiaSteps": {"type": "array", "items": {"type": "object"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "objectName": {"type": "string"},
        "formName": {"type": "string"},
        "metadataFullName": {"type": "string"},
        "saveAs": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
        "timeout": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "reference": {
      "type": "object",
      "required": ["kind", "metadataName", "uuid"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["catalog", "document"]},
        "metadataName": {"type": "string", "minLength": 1},
        "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
        "choiceField": {"type": "string", "minLength": 1}
      }
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"enum": ["assertConnected", "openNavigationLink", "executeCommand", "nextWindow", "activateWindow", "waitForm", "waitFormClosed", "waitElement", "assertElement", "inspectUi", "inspectUI", "inspectTable", "inspectCommandInterface", "clickCommandInterface", "activateForm", "activateElement", "inputText", "selectReference", "selectFromDropdown", "setCheckbox", "openChoice", "selectTableRow", "assertTableRow", "inputTableCell", "click", "assertField", "handleDialog", "closeForm"]},
        "name": {"type": "string"},
        "command": {"type": "string"},
        "link": {"type": "string", "minLength": 1},
        "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
        "kind": {"enum": ["catalog", "document"]},
        "metadataName": {"type": "string", "minLength": 1},
        "form": {"type": "string"},
        "saveAs": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
        "title": {"type": "string"},
        "objectName": {"type": "string"},
        "formName": {"type": "string"},
        "timeout": {"type": "number", "exclusiveMinimum": 0},
        "pollingInterval": {"type": "number", "minimum": 1, "maximum": 30},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "strategy": {"enum": ["auto", "dropdownExact", "typeAhead", "choiceForm"]},
        "match": {"enum": ["exact", "first"]},
        "direction": {"enum": ["down", "up", "both"]},
        "depth": {"type": "integer", "minimum": 1, "maximum": 10},
        "value": {},
        "expected": {},
        "exists": {"type": "boolean"},
        "visible": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "readOnly": {"type": "boolean"},
        "checked": {"type": "boolean"},
        "strict": {"type": "boolean"},
        "finishRow": {"type": "boolean"},
        "onChangeWait": {"type": "integer", "minimum": 0, "maximum": 30, "default": 1},
        "replace": {"type": "boolean", "default": true},
        "waitClosed": {"type": "boolean"},
        "optional": {"type": "boolean"},
        "elementType": {"enum": ["field", "button", "table", "group", "decoration", "addition"]},
        "onPrompt": {"enum": ["discard", "save", "cancel"]},
        "dialogTitle": {"type": "string"},
        "promptTimeout": {"type": "number", "exclusiveMinimum": 0},
        "row": {"type": "object", "minProperties": 1},
        "choiceRow": {"type": "object", "minProperties": 1},
        "reference": {"$ref": "#/$defs/reference"},
        "choiceField": {"type": "string", "minLength": 1},
        "element": {"$ref": "#/$defs/selector"},
        "field": {"$ref": "#/$defs/selector"},
        "button": {"$ref": "#/$defs/selector"},
        "dialogButton": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/selector"}]},
        "table": {"$ref": "#/$defs/selector"},
        "choiceTable": {"$ref": "#/$defs/selector"},
        "targetForm": {"$ref": "#/$defs/selector"},
        "choiceForm": {"$ref": "#/$defs/selector"}
      },
      "additionalProperties": false
    }
  }
}
