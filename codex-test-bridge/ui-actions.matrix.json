    {"name": "activateElement", "visibility": "public", "scope": "element", "elementTypes": ["field", "button", "table", "group"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["elements.activate"], "variants": [{"id": "field", "match": {"elementType": "field"}}, {"id": "button", "match": {"elementType": "button"}}, {"id": "table", "match": {"elementType": "table"}}, {"id": "group", "match": {"elementType": "group"}}]},
    {"name": "clickElement", "visibility": "public", "scope": "element", "elementTypes": ["button", "group", "decoration"], "backendElementTypes": {"xvfb": ["button", "group", "decoration"], "windowsDesktop": ["button", "group", "decoration"]}, "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["button.form", "decoration.click"], "variants": [{"id": "button-native", "match": {"elementType": "button", "clickMode": "auto"}}, {"id": "decoration-auto", "match": {"elementType": "decoration", "clickMode": "auto"}}, {"id": "decoration-activated", "match": {"elementType": "decoration", "clickMode": "activated"}}, {"id": "group-activated", "match": {"elementType": "group", "clickMode": "activated"}}]},
    {"name": "setGroupExpanded", "visibility": "public", "scope": "group", "elementTypes": ["group"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["group.expand-collapse"], "variants": [{"id": "collapse", "match": {"expanded": false}}, {"id": "expand", "match": {"expanded": true}}]},
    {"name": "assertGroupState", "visibility": "public", "scope": "group", "elementTypes": ["group"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["group.expand-collapse"], "variants": [{"id": "collapsed", "match": {"expanded": false}}, {"id": "expanded", "match": {"expanded": true}}]},
