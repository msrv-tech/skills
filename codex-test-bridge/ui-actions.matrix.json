  "elementTypes": ["field", "button", "table", "group", "decoration", "addition"],
  "actions": [
    {"name": "assertConnected", "visibility": "public", "scope": "session", "elementTypes": [], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["session.connected"]},
    {"name": "openNavigationLink", "visibility": "public", "scope": "window", "elementTypes": [], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["navigation.link"], "variants": [{"id": "literal-link", "match": {"kind": null}}, {"id": "catalog-uuid", "match": {"kind": "catalog"}}, {"id": "document-uuid", "match": {"kind": "document"}}]},
    {"name": "openClientNavigationLink", "visibility": "internal", "scope": "window", "elementTypes": [], "backends": ["xvfb", "windowsDesktop"], "coverage": "internal", "cases": ["navigation.client-command"]},
    {"name": "openDataProcessor", "visibility": "public", "scope": "form", "elementTypes": [], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["form.data-processor"]},
