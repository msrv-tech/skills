    {"name": "selectReference", "visibility": "public", "scope": "field", "elementTypes": ["field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["reference.catalog", "reference.document", "reference.characteristic", "reference.account", "reference.calculation-type", "reference.composite", "reference.table", "reference.choice-form-selection"], "variants": [{"id": "dropdown-exact", "match": {"strategy": "dropdownExact"}}, {"id": "type-ahead", "match": {"strategy": "typeAhead"}}, {"id": "automatic", "match": {"strategy": "auto"}}, {"id": "choice-form", "match": {"strategy": "choiceForm"}}, {"id": "strict", "match": {"strict": true}}, {"id": "non-strict", "match": {"strict": false}}, {"id": "table-field", "match": {"finishRow": true}}, {"id": "composite-type", "match": {"referenceType": "Codex UI fixture catalog"}}]},
    {"name": "createReference", "visibility": "public", "scope": "field", "elementTypes": ["field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["reference.create"]},
    {"name": "selectFromDropdown", "visibility": "public", "scope": "field", "elementTypes": ["field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["field.dropdown", "reference.enum"], "variants": [{"id": "exact", "match": {"match": "exact"}}, {"id": "first", "match": {"match": "first"}}]},
    {"name": "setCheckbox", "visibility": "public", "scope": "field", "elementTypes": ["field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["field.checkbox"], "variants": [{"id": "checked", "match": {"checked": true}}, {"id": "unchecked", "match": {"checked": false}}]},
    {"name": "openChoice", "visibility": "public", "scope": "field", "elementTypes": ["field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["reference.choice-form"]},
    {"name": "selectTableRow", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.rows"], "variants": [{"id": "position", "match": {"select": false}}, {"id": "select", "match": {"select": true}}]},
    {"name": "assertTableRow", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.rows"], "variants": [{"id": "exists", "match": {"exists": true}}, {"id": "missing", "match": {"exists": false}}]},
    {"name": "selectAllTableRows", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.selection"]},
    {"name": "assertSelectedRows", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.selection"]},
    {"name": "setTableOrder", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.order"]},
    {"name": "expandTreeRow", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.tree"]},
    {"name": "collapseTreeRow", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.tree"]},
    {"name": "assertTreeRowState", "visibility": "public", "scope": "table", "elementTypes": ["table"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.tree"], "variants": [{"id": "collapsed-expandable", "match": {"expanded": false, "canExpand": true}}, {"id": "expanded", "match": {"expanded": true, "canExpand": true}}]},
    {"name": "pressKey", "visibility": "public", "scope": "window", "elementTypes": [], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["window.keyboard"]},
    {"name": "inputTableCell", "visibility": "public", "scope": "table", "elementTypes": ["table", "field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["table.edit-cell"], "variants": [{"id": "finish-row", "match": {"finishRow": true}}, {"id": "keep-editing", "match": {"finishRow": false}}]},
    {"name": "click", "visibility": "public", "scope": "button", "elementTypes": ["button"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["button.form"]},
    {"name": "assertButtonState", "visibility": "public", "scope": "button", "elementTypes": ["button"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["button.state"]},
    {"name": "assertSpreadsheet", "visibility": "public", "scope": "field", "elementTypes": ["field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["field.spreadsheet-document"]},
    {"name": "invokeFormCommand", "visibility": "public", "scope": "button", "elementTypes": ["button"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["button.form-command"]},
    {"name": "assertField", "visibility": "public", "scope": "field", "elementTypes": ["field"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["field.text", "field.multiline", "field.number", "field.date", "field.text-document", "table.edit-cell"], "variants": [{"id": "equals", "match": {"assertion": "expected"}}, {"id": "contains", "match": {"assertion": "contains"}}, {"id": "not-empty", "match": {"assertion": "notEmpty"}}]},
    {"name": "handleDialog", "visibility": "public", "scope": "dialog", "elementTypes": ["button"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["dialog.message"]},
    {"name": "closeForm", "visibility": "public", "scope": "form", "elementTypes": [], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["form.lifecycle"], "variants": [{"id": "wait", "match": {"waitClosed": true}}, {"id": "deferred-wait", "match": {"waitClosed": false}}]}
  ]
