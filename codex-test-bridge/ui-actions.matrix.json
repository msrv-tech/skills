    {"name": "assertElement", "visibility": "public", "scope": "element", "elementTypes": ["field", "button", "table", "group", "decoration", "addition"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["elements.inventory", "field.readonly", "field.disabled", "field.text-document", "field.formatted-document", "field.spreadsheet-document"], "variants": [{"id": "field", "match": {"elementType": "field"}}, {"id": "button", "match": {"elementType": "button"}}, {"id": "table", "match": {"elementType": "table"}}, {"id": "group", "match": {"elementType": "group"}}, {"id": "decoration", "match": {"elementType": "decoration"}}, {"id": "addition", "match": {"elementType": "addition"}}]},
    {"name": "inspectUi", "visibility": "public", "scope": "diagnostic", "elementTypes": ["field", "button", "table", "group", "decoration", "addition"], "backends": ["xvfb", "windowsDesktop"], "coverage": "fixture", "cases": ["elements.inventory"]},
