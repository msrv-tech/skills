    {"action": "assertField", "form": "task", "field": {"objectName": "TaskDescription"}, "expected": "Fixture task Alpha"},
    {"action": "assertField", "form": "task", "field": {"objectName": "TaskFixtureText"}, "expected": "task:ready"},
    {"action": "closeForm", "form": "task"}
  ]
}
