Перем CTB_ТекущийИдентификаторЗадания;
Перем CTB_ТекущийТестКлиент;
Перем CTB_ЗакрыватьТестКлиентПослеСценария;
Перем CTB_ИдентификаторЗаданияКлиентскихФорм;
Перем CTB_ХостТестКлиента;
Перем CTB_ПортТестКлиента;
Перем CTB_RuntimeForm;

&После("ПриНачалеРаботыСистемы")
Процедура CTB_ПриНачалеРаботыСистемы()
	CTB_ТекущийТестКлиент = Неопределено;
	CTB_ЗакрыватьТестКлиентПослеСценария = Ложь;
	Если Лев(ПараметрЗапуска, СтрДлина("CodexUITestClient")) = "CodexUITestClient" Тогда
		ПараметрыКлиента = CTB_РазобратьПараметрыЗапуска(ПараметрЗапуска);
		CTB_ИдентификаторЗаданияКлиентскихФорм = CTB_Получить(ПараметрыКлиента, "Job", "");
		// Команды для warm TestClient выполняются синхронно общей командой
		// CodexNavigate через поддерживаемый TestManager.ВыполнитьКоманду().
		// Обработчики ожидания в /TestClient после подключения TestManager не
		// планируются платформой, поэтому здесь не запускаем timer/runtime form.
		Возврат;
	КонецЕсли;
	Если Лев(ПараметрЗапуска, СтрДлина("CodexUITest")) <> "CodexUITest" Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыТеста = CTB_РазобратьПараметрыЗапуска(ПараметрЗапуска);
	ИдентификаторЗадания = CTB_Получить(ПараметрыТеста, "Job", "");
	ВстроенныйСценарий = CTB_Получить(ПараметрыТеста, "Scenario", "");
	Результат = Новый Структура;
	
	Попытка
		Если ПустаяСтрока(ИдентификаторЗадания) И ПустаяСтрока(ВстроенныйСценарий) Тогда
			ВызватьИсключение "CodexUITest: Job or Scenario is required";
		КонецЕсли;
		Результат = CTB_ВыполнитьСценарий(ИдентификаторЗадания, ПараметрыТеста);
	Исключение
		Результат.Вставить("ok", Ложь);
		Результат.Вставить("status", "failed");
		Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;
	
	Если Не ПустаяСтрока(ВстроенныйСценарий) Тогда
		Сообщить("CODEX_UI_RESULT:" + CTB_ЗаписатьJSONСтроку(Результат));
	ИначеЕсли Не ПустаяСтрока(ИдентификаторЗадания) Тогда
		CodexUIJobsServer.СохранитьРезультат(
			ИдентификаторЗадания,
			CTB_ЗаписатьJSONСтроку(Результат),
			CTB_Получить(Результат, "status", "failed"));
	КонецЕсли;

	Если CTB_ЗакрыватьТестКлиентПослеСценария Тогда
		// Даем внешнему worker забрать итог и снять экран до закрытия клиента.
		Для НомерОжидания = 1 По 2 Цикл
			CTB_ПаузаТестКлиента(CTB_ТекущийТестКлиент);
		КонецЦикла;
		CTB_ЗакрытьТестКлиентШтатно(CTB_ТекущийТестКлиент);
	КонецЕсли;
	
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

Процедура CTB_ОбработатьКомандуОткрытияФормы() Экспорт
	Если ПустаяСтрока(CTB_ИдентификаторЗаданияКлиентскихФорм) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Задание = CodexUIJobsServer.ПолучитьЗадание(CTB_ИдентификаторЗаданияКлиентскихФорм);
		Если Задание = Неопределено Или (Задание.status <> "client-form-request" И Задание.status <> "client-runtime-request" И Задание.status <> "client-ready-request") Тогда
			Возврат;
		КонецЕсли;
		Если Задание.status = "client-ready-request" Тогда
			Ответ = Новый Структура("ok,status", Истина, "client-ready-response");
			CodexUIJobsServer.СохранитьРезультат(
				CTB_ИдентификаторЗаданияКлиентскихФорм,
				CTB_ЗаписатьJSONСтроку(Ответ),
				"client-ready-response");
			Возврат;
		КонецЕсли;
		Команда = CTB_ПрочитатьJSONСтроку(Задание.result);
		Если Задание.status = "client-runtime-request" Тогда
			CTB_ВыполнитьКомандуАктивнойФормы(Команда);
			Возврат;
		КонецЕсли;
		ПолноеИмяФормы = Строка(CTB_ОбязательноеПоле(Команда, "formName"));
		ПараметрыОткрытия = Неопределено;
		АдресПараметров = Строка(CTB_Получить(Команда, "parametersAddress", ""));
		Если CTB_Получить(Команда, "taskReferenceByUuid", Ложь) Тогда
			ИмяЗадачи = Строка(CTB_ОбязательноеПоле(Команда, "metadataName"));
			UUIDЗадачи = Строка(CTB_ОбязательноеПоле(Команда, "uuid"));
			ПараметрыОткрытия = Новый Структура("Ключ", CodexUIJobsServer.ПолучитьСсылкуЗадачи(ИмяЗадачи, UUIDЗадачи));
		ИначеЕсли CTB_Получить(Команда, "persistentPayload", Ложь) Тогда
			ПараметрыОткрытия = CodexUIJobsServer.ПолучитьPayload(CTB_ИдентификаторЗаданияКлиентскихФорм);
		ИначеЕсли Не ПустаяСтрока(АдресПараметров) Тогда
			ПараметрыОткрытия = ПолучитьИзВременногоХранилища(АдресПараметров);
		КонецЕсли;
		АдресСсылки = Строка(CTB_Получить(Команда, "referenceAddress", ""));
		Если ПараметрыОткрытия = Неопределено И Не ПустаяСтрока(АдресСсылки) Тогда
			ПараметрыОткрытия = Новый Структура("Ключ", ПолучитьИзВременногоХранилища(АдресСсылки));
		КонецЕсли;
		ДиагностикаПараметров = CTB_ДиагностикаПараметровОткрытия(ПараметрыОткрытия);
		Если CTB_Получить(Команда, "requireFormKey", Ложь) И Не CTB_Получить(ДиагностикаПараметров, "keyFilled", Ложь) Тогда
			ВызватьИсключение "Task execution form did not receive a typed key: " + CTB_ЗаписатьJSONСтроку(ДиагностикаПараметров);
		КонецЕсли;
		ОткрытьФорму(ПолноеИмяФормы, ПараметрыОткрытия);
		Ответ = Новый Структура("ok,formName,parameters", Истина, ПолноеИмяФормы, ДиагностикаПараметров);
		CodexUIJobsServer.СохранитьРезультат(
			CTB_ИдентификаторЗаданияКлиентскихФорм,
			CTB_ЗаписатьJSONСтроку(Ответ),
			"client-form-response");
	Исключение
		Ответ = Новый Структура("ok,error", Ложь, ОписаниеОшибки());
		CodexUIJobsServer.СохранитьРезультат(
			CTB_ИдентификаторЗаданияКлиентскихФорм,
			CTB_ЗаписатьJSONСтроку(Ответ),
			"client-form-response");
	КонецПопытки;
КонецПроцедуры

Процедура CTB_ВыполнитьКомандуАктивнойФормы(Запрос)
	Попытка
		ИмяФормы = Строка(CTB_ОбязательноеПоле(Запрос, "formName"));
		ИмяКоманды = Строка(CTB_ОбязательноеПоле(Запрос, "command"));
		Если Не CTB_КорректныйИдентификаторКоманды(ИмяКоманды) Тогда
			ВызватьИсключение "Invalid form command identifier";
		КонецЕсли;
		Окно = АктивноеОкно();
		Если Окно = Неопределено Тогда ВызватьИсключение "No active client window"; КонецЕсли;
		Содержимое = Окно.Содержимое;
		Форма = Неопределено;
		Если ТипЗнч(Содержимое) = Тип("УправляемаяФорма") Тогда
			Форма = Содержимое;
		Иначе
			Для Каждого Элемент Из Содержимое Цикл
				Если ТипЗнч(Элемент) = Тип("УправляемаяФорма") Тогда Форма = Элемент; Прервать; КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Форма = Неопределено Или Форма.ИмяФормы <> ИмяФормы Тогда
			ВызватьИсключение "Active form does not match requested form";
		КонецЕсли;
		КомандаФормы = Форма.Команды.Найти(ИмяКоманды);
		Если КомандаФормы = Неопределено Тогда ВызватьИсключение "Form command was not found"; КонецЕсли;
		CTB_RuntimeForm = Форма;
		Выполнить("CTB_RuntimeForm." + ИмяКоманды + "(CTB_RuntimeForm.Команды." + ИмяКоманды + ");");
		Ответ = Новый Структура("ok,formName,command", Истина, ИмяФормы, ИмяКоманды);
		CodexUIJobsServer.СохранитьРезультат(CTB_ИдентификаторЗаданияКлиентскихФорм, CTB_ЗаписатьJSONСтроку(Ответ), "client-runtime-response");
	Исключение
		Ответ = Новый Структура("ok,error", Ложь, ОписаниеОшибки());
		CodexUIJobsServer.СохранитьРезультат(CTB_ИдентификаторЗаданияКлиентскихФорм, CTB_ЗаписатьJSONСтроку(Ответ), "client-runtime-response");
	КонецПопытки;
КонецПроцедуры

Функция CTB_КорректныйИдентификаторКоманды(Значение)
	Если ПустаяСтрока(Значение) Тогда Возврат Ложь; КонецЕсли;
	Допустимые = "_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯabcdefghijklmnopqrstuvwxyzабвгдежзийклмнопрстуфхцчшщъыьэюя";
	Для Номер = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Допустимые, Сред(Значение, Номер, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция CTB_ДиагностикаПараметровОткрытия(ПараметрыОткрытия)
	Результат = Новый Структура("provided,keyPresent,keyFilled,keyType,keyUuid", ПараметрыОткрытия <> Неопределено, Ложь, Ложь, "", "");
	Если ПараметрыОткрытия = Неопределено Тогда Возврат Результат; КонецЕсли;
	Ключ = Неопределено;
	Если Не ПараметрыОткрытия.Свойство("Ключ", Ключ) Тогда Возврат Результат; КонецЕсли;
	Результат.keyPresent = Истина;
	Попытка Результат.keyType = Строка(ТипЗнч(Ключ)); Исключение КонецПопытки;
	Попытка
		Результат.keyFilled = ЗначениеЗаполнено(Ключ);
		Если Результат.keyFilled Тогда Результат.keyUuid = Строка(Ключ.УникальныйИдентификатор()); КонецЕсли;
	Исключение
		Результат.keyFilled = Ложь;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция CTB_ВыполнитьСценарий(ИдентификаторЗадания, ПараметрыТеста, ВнешнийТестКлиент = Неопределено, ВнешнийСценарий = Неопределено)
	CTB_ТекущийИдентификаторЗадания = ИдентификаторЗадания;
	Если ВнешнийСценарий <> Неопределено Тогда
		Сценарий = ВнешнийСценарий;
	Иначе
	ВстроенныйСценарий = CTB_Получить(ПараметрыТеста, "Scenario", "");
	Если Не ПустаяСтрока(ВстроенныйСценарий) Тогда
		Сценарий = CTB_ПрочитатьJSONСтроку(CTB_ДекодироватьBase64ASCII(ВстроенныйСценарий));
	Иначе
		Сценарий = CTB_ПрочитатьJSONСтроку(CodexUIJobsServer.ПолучитьСценарий(ИдентификаторЗадания));
	КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(CTB_Получить(Сценарий, "scenarios", Неопределено)) = Тип("Массив") Тогда
		Возврат CTB_ВыполнитьНаборUIСценариев(ИдентификаторЗадания, ПараметрыТеста, Сценарий);
	КонецЕсли;
	Хост = CTB_Получить(ПараметрыТеста, "Host", "127.0.0.1");
	Порт = Число(CTB_Получить(ПараметрыТеста, "Port", "1538"));
	CTB_ХостТестКлиента = Хост;
	CTB_ПортТестКлиента = Порт;
	ТестКлиент = ВнешнийТестКлиент;
	Если ТестКлиент = Неопределено Тогда
		ТестКлиент = CTB_СоздатьТестКлиент(Хост, Порт);
	КонецЕсли;
	CTB_ТекущийТестКлиент = ТестКлиент;
	Если ВнешнийТестКлиент = Неопределено Тогда
		CTB_ЗакрыватьТестКлиентПослеСценария = CTB_Получить(Сценарий, "closeTestClientOnFinish", Истина);
	КонецЕсли;
	ЗакрытыеСтартовыеДиалоги = Новый Массив;
	Если ВнешнийТестКлиент = Неопределено И CTB_Получить(Сценарий, "dismissStartupDialogs", Истина) Тогда
		ЗакрытыеСтартовыеДиалоги = CTB_УбратьСтартовыеДиалоги(ТестКлиент, Сценарий);
		// Некоторые конфигурации БСП при /TestClient показывают обязательный
		// диалог перезапуска. Нажатие принимается старым соединением, а новый
		// клиент на том же порту нужно явно подключить к TestManager повторно.
		Если ЗакрытыеСтартовыеДиалоги.Найти("restartTestClient") <> Неопределено Тогда
			ТестКлиент = CTB_ВосстановитьСоединениеТестКлиента(ТестКлиент, Хост, Порт);
		КонецЕсли;
	КонецЕсли;
	СекундСтабилизации = Число(CTB_Получить(Сценарий, "startupSettleSeconds", 3));
	Для СекундаСтабилизации = 1 По СекундСтабилизации Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
	КонецЦикла;
	
	ШагиСценария = CTB_Получить(Сценарий, "steps", Новый Массив);
	ВсегоШагов = ШагиСценария.Количество();
	СохраненныеОбъекты = Новый Соответствие;
	РезультатыШагов = Новый Массив;
	Успех = Истина;
	НомерШага = 0;
	CTB_СохранитьПрогресс(ИдентификаторЗадания, Сценарий, 0, ВсегоШагов, Неопределено, РезультатыШагов, "connected");
	
	Для Каждого Шаг Из ШагиСценария Цикл
		НомерШага = НомерШага + 1;
		СохраненныеОбъекты.Удалить("__CTB_BeforeNavigation");
		РезультатШага = Новый Структура;
		РезультатШага.Вставить("index", НомерШага);
		РезультатШага.Вставить("action", CTB_Получить(Шаг, "action", ""));
		РезультатШага.Вставить("name", CTB_Получить(Шаг, "name", "step-" + СокрЛП(Строка(НомерШага))));
		НачалоШага = ТекущаяДата();
		CTB_СохранитьПрогресс(ИдентификаторЗадания, Сценарий, НомерШага, ВсегоШагов, РезультатШага, РезультатыШагов, "starting");
		
		Попытка
			ТестКлиент = CTB_ВосстановитьСоединениеТестКлиента(ТестКлиент, Хост, Порт);
			ФактическоеЗначение = CTB_ВыполнитьШаг(ТестКлиент, Шаг, СохраненныеОбъекты);
			РезультатШага.Вставить("status", "passed");
			Если ФактическоеЗначение <> Неопределено Тогда
				РезультатШага.Вставить("actual", ФактическоеЗначение);
			КонецЕсли;
		Исключение
			Успех = Ложь;
			РезультатШага.Вставить("status", "failed");
			РезультатШага.Вставить("error", ОписаниеОшибки());
			Диагностика = CTB_СобратьДиагностикуФорм(ТестКлиент);
			ДиагностикаДоНавигации = СохраненныеОбъекты.Получить("__CTB_BeforeNavigation");
			Если ДиагностикаДоНавигации <> Неопределено Тогда
				Диагностика.Вставить("beforeNavigation", ДиагностикаДоНавигации);
			КонецЕсли;
			РезультатШага.Вставить("diagnostics", Диагностика);
		КонецПопытки;
		РезультатШага.Вставить("durationMs", (ТекущаяДата() - НачалоШага) * 1000);
		
		РезультатыШагов.Добавить(РезультатШага);
		CTB_СохранитьПрогресс(ИдентификаторЗадания, Сценарий, НомерШага, ВсегоШагов, РезультатШага, РезультатыШагов, РезультатШага.status);
		Если Не Успех Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Успех);
	Ответ.Вставить("status", ?(Успех, "passed", "failed"));
	Ответ.Вставить("name", CTB_Получить(Сценарий, "name", "unnamed-ui-scenario"));
	Ответ.Вставить("steps", РезультатыШагов);
	Ответ.Вставить("count", РезультатыШагов.Количество());
	Ответ.Вставить("dismissedStartupDialogs", ЗакрытыеСтартовыеДиалоги);
	Возврат Ответ;
КонецФункции

Функция CTB_ВыполнитьНаборUIСценариев(ИдентификаторЗадания, ПараметрыТеста, Набор)
	Хост = CTB_Получить(ПараметрыТеста, "Host", "127.0.0.1");
	Порт = Число(CTB_Получить(ПараметрыТеста, "Port", "1538"));
	ТестКлиент = CTB_СоздатьТестКлиент(Хост, Порт);
	CTB_ТекущийТестКлиент = ТестКлиент;
	CTB_ЗакрыватьТестКлиентПослеСценария = Истина;
	Результаты = Новый Массив;
	Успех = Истина;
	НомерСценария = 0;
	СценарииНабора = CTB_Получить(Набор, "scenarios", Новый Массив);
	ВсегоСценариев = СценарииНабора.Количество();
	Для Каждого ЭлементНабора Из СценарииНабора Цикл
		НомерСценария = НомерСценария + 1;
		Подготовка = CTB_ЗапроситьСервернуюФазуНабора(ИдентификаторЗадания, ЭлементНабора, НомерСценария, "before");
		Сценарий = CTB_Получить(Подготовка, "scenario", CTB_Получить(ЭлементНабора, "scenario", ЭлементНабора));
		Если CTB_Получить(Подготовка, "ok", Истина) Тогда
			// HTTP server hook выполняется вне сеанса TestManager. Пробный вызов
			// GetActiveWindow может ещё проходить по устаревшему каналу, тогда как
			// первое ОжидатьОтображениеОбъекта уже получает сетевую ошибку. Поэтому
			// после внешней фазы всегда выполняем штатное переподключение, не
			// перезапуская сам процесс TestClient.
			ТестКлиент = CTB_ПереподключитьТестКлиентПослеСервернойФазы(ТестКлиент, Хост, Порт);
			CTB_ТекущийТестКлиент = ТестКлиент;
			РезультатСценария = CTB_ВыполнитьСценарий(ИдентификаторЗадания, ПараметрыТеста, ТестКлиент, Сценарий);
		Иначе
			РезультатСценария = Новый Структура("ok,status,name,steps,error", Ложь, "failed", CTB_Получить(Сценарий, "name", "unnamed-ui-scenario"), Новый Массив, CTB_Получить(Подготовка, "error", "Server before phase failed"));
		КонецЕсли;
		После = CTB_ЗапроситьСервернуюФазуНабора(ИдентификаторЗадания, ЭлементНабора, НомерСценария, "after");
		Финализация = CTB_ЗапроситьСервернуюФазуНабора(ИдентификаторЗадания, ЭлементНабора, НомерСценария, "finally");
		РезультатСценария.Вставить("before", Подготовка);
		РезультатСценария.Вставить("after", После);
		РезультатСценария.Вставить("finally", Финализация);
		РезультатСценария.Вставить("scenarioIndex", НомерСценария);
		РезультатСценария.Вставить("totalScenarios", ВсегоСценариев);
		РезультатСценария.Вставить("scenarioId", CTB_Получить(ЭлементНабора, "id", "scenario-" + СокрЛП(Строка(НомерСценария))));
		РезультатСценария.Вставить("source", CTB_Получить(ЭлементНабора, "source", ""));
		Результаты.Добавить(РезультатСценария);
		CTB_ЗакрытьФормыСценария(ТестКлиент);
		Если Не CTB_Получить(РезультатСценария, "ok", Ложь) Тогда
			Успех = Ложь;
			Если CTB_Получить(Набор, "failFast", Ложь) Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Успех);
	Ответ.Вставить("status", ?(Успех, "passed", "failed"));
	Ответ.Вставить("name", CTB_Получить(Набор, "name", "ui-suite"));
	Ответ.Вставить("scenarios", Результаты);
	Ответ.Вставить("count", Результаты.Количество());
	Возврат Ответ;
КонецФункции

Функция CTB_ЗапроситьСервернуюФазуНабора(ИдентификаторЗадания, ЭлементНабора, НомерСценария, Фаза)
	Определение = CTB_Получить(ЭлементНабора, Фаза, Неопределено);
	Если Определение = Неопределено Тогда Возврат Новый Структура("ok", Истина); КонецЕсли;
	Запрос = Новый Структура;
	Запрос.Вставить("ok", Истина); Запрос.Вставить("status", "server-hook-request");
	Запрос.Вставить("hookId", Строка(НомерСценария) + ":" + Фаза);
	Запрос.Вставить("phase", Фаза); Запрос.Вставить("scenarioIndex", НомерСценария);
	Запрос.Вставить("scenarioName", CTB_Получить(CTB_Получить(ЭлементНабора, "scenario", Новый Структура), "name", "unnamed-ui-scenario"));
	Запрос.Вставить("definition", Определение); Запрос.Вставить("scenario", CTB_Получить(ЭлементНабора, "scenario", Неопределено));
	CodexUIJobsServer.СохранитьРезультат(ИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Запрос), "server-hook-request");
	// Server hook выполняется внешним HTTP-сеансом и не использует TestClient.
	// Нельзя разрывать TestManager -> TestClient перед hook: у прогретого
	// TestClient это отключает его обработчик ожидания, который принимает
	// последующую команду открытия формы. Сохраняем пару процессов; при
	// фактическом сетевом сбое переподключение ниже выполнит аварийный fallback.
	КонецОжидания = ТекущаяДата() + 900;
	Пока ТекущаяДата() <= КонецОжидания Цикл
		// Только обращение к job: TestClient до ответа hook не трогаем.
		Задание = CodexUIJobsServer.ПолучитьЗадание(ИдентификаторЗадания);
		Если CTB_Получить(Задание, "status", "") = "server-hook-response" Тогда
			Возврат CTB_ПрочитатьJSONСтроку(CTB_Получить(Задание, "result", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ok,error", Ложь, "Server hook timed out");
КонецФункции

Процедура CTB_ЗакрытьФормыСценария(ТестКлиент)
	Если ТестКлиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Формы = CTB_ПолучитьОткрытыеФормы(ТестКлиент, Истина);
		Для Каждого Форма Из Формы Цикл
			Попытка
				Форма.Закрыть();
			Исключение
			КонецПопытки;
		КонецЦикла;
		CTB_ПаузаТестКлиента(ТестКлиент);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура CTB_ЗакрытьТестКлиентШтатно(ТестКлиент)
	Если ТестКлиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Окна = ТестКлиент.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
		Для Каждого Окно Из Окна Цикл
			Попытка
				Если Окно.Основное Тогда
					Окно.Закрыть();
					Прервать;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	CTB_ПаузаТестКлиента(ТестКлиент);
	Попытка
		ТестКлиент.РазорватьСоединение();
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция CTB_СоздатьТестКлиент(Хост, Порт)
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(Хост);
	ПараметрыКонструктора.Добавить(Порт);
	// /TestManager may start before /TestClient.  This is the native platform
	// lifecycle: keep creating a fresh proxy and retry the initial attach while
	// the client opens its testing port, rather than treating the first refused
	// connection as a terminal worker failure.
	ВремяОкончания = ТекущаяДата() + 90;
	ПоследняяОшибка = "";
	Пока ТекущаяДата() <= ВремяОкончания Цикл
		Попытка
			ТестКлиент = Новый(Тип("ТестируемоеПриложение"), ПараметрыКонструктора);
			ТестКлиент.УстановитьСоединение();
			Возврат ТестКлиент;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "TestClient initial connection was not established. Last error: " + ПоследняяОшибка;
КонецФункции

Функция CTB_СоединениеТестКлиентаАктивно(ТестКлиент)
	Попытка
		ТестКлиент.ПолучитьАктивноеОкно();
		CTB_ПаузаТестКлиента(ТестКлиент);
		ТестКлиент.ПолучитьАктивноеОкно();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция CTB_ВосстановитьСоединениеТестКлиента(ТестКлиент, Хост, Порт)
	Если CTB_СоединениеТестКлиентаАктивно(ТестКлиент) Тогда
		Возврат ТестКлиент;
	КонецЕсли;
	ВремяОкончания = ТекущаяДата() + 90;
	ПоследняяОшибка = "";
	Пока ТекущаяДата() <= ВремяОкончания Цикл
		Попытка
			НовыйТестКлиент = CTB_СоздатьТестКлиент(Хост, Порт);
			Если CTB_СоединениеТестКлиентаАктивно(НовыйТестКлиент) Тогда
				Возврат НовыйТестКлиент;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;
		Попытка
			ТестКлиент.НайтиОбъект(Тип("ТестируемаяФорма"), "__CTB_WAIT_RECONNECT__", "__CTB_WAIT_RECONNECT__", 1);
		Исключение
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "TestClient connection was not restored. Last error: " + ПоследняяОшибка;
КонецФункции

Функция CTB_ПереподключитьТестКлиентПослеСервернойФазы(ТестКлиент, Хост, Порт)
	// Нормальный путь после server hook ничего не разрывает. Функция оставлена
	// как единая точка проверки живости и восстанавливает соединение только
	// если оно действительно потеряно.
	Возврат CTB_ВосстановитьСоединениеТестКлиента(ТестКлиент, Хост, Порт);
КонецФункции

Процедура CTB_СохранитьПрогресс(ИдентификаторЗадания, Сценарий, НомерШага, ВсегоШагов, ТекущийШаг, РезультатыШагов, Стадия)
	Если ПустаяСтрока(ИдентификаторЗадания) Тогда
		Возврат;
	КонецЕсли;
	Прогресс = Новый Структура;
	Прогресс.Вставить("ok", Истина);
	Прогресс.Вставить("status", "running");
	Прогресс.Вставить("stage", Стадия);
	Прогресс.Вставить("name", CTB_Получить(Сценарий, "name", "unnamed-ui-scenario"));
	Прогресс.Вставить("currentStep", НомерШага);
	Прогресс.Вставить("totalSteps", ВсегоШагов);
	Прогресс.Вставить("step", ТекущийШаг);
	Прогресс.Вставить("steps", РезультатыШагов);
	Прогресс.Вставить("lastHeartbeatAt", Строка(ТекущаяДата()));
	Попытка
		CodexUIJobsServer.СохранитьРезультат(ИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Прогресс), "running");
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция CTB_СобратьДиагностикуФорм(ТестКлиент)
	Результат = Новый Структура;
	ОписанияОкон = Новый Массив;
	ОписанияФорм = Новый Массив;
	Результат.Вставить("windows", ОписанияОкон);
	Результат.Вставить("forms", ОписанияФорм);
	Попытка
		Окна = ТестКлиент.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
		Для Каждого Окно Из Окна Цикл
			ОписаниеОкна = Новый Структура;
			Попытка ОписаниеОкна.Вставить("title", Окно.ТекстЗаголовка); Исключение КонецПопытки;
			Попытка ОписаниеОкна.Вставить("tree", CTB_ОписатьДеревоUI(Окно, 4)); Исключение КонецПопытки;
			ОписанияОкон.Добавить(ОписаниеОкна);
		КонецЦикла;
	Исключение
		Результат.Вставить("windowsError", ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Формы = CTB_ПолучитьОткрытыеФормы(ТестКлиент);
		Для Каждого Форма Из Формы Цикл
			Описание = Новый Структура;
			Попытка Описание.Вставить("title", Форма.ТекстЗаголовка); Исключение КонецПопытки;
			Попытка Описание.Вставить("objectName", Форма.Имя); Исключение КонецПопытки;
			Описание.Вставить("formName", CTB_ИмяФормы(Форма));
			Попытка Описание.Вставить("tree", CTB_ОписатьДеревоUI(Форма, 4)); Исключение КонецПопытки;
			ОписанияФорм.Добавить(Описание);
		КонецЦикла;
	Исключение
		Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция CTB_ВыполнитьШаг(ТестКлиент, Шаг, СохраненныеОбъекты)
	Действие = НРег(CTB_Получить(Шаг, "action", ""));
	
	Если Действие = "assertconnected" Тогда
		Возврат Истина;
	ИначеЕсли Действие = "opennavigationlink" Тогда
		Ссылка = Строка(CTB_ОбязательноеПоле(Шаг, "link"));
		Возврат CTB_ОткрытьНавигационнуюЦель(ТестКлиент, Шаг, Ссылка, СохраненныеОбъекты);
	ИначеЕсли Действие = "openclientnavigationlink" Тогда
		Возврат CTB_ОткрытьФормуЧерезТестКлиент(ТестКлиент, Шаг, СохраненныеОбъекты);
	ИначеЕсли Действие = "opendataprocessor" Тогда
		ШагОткрытия = Новый Структура("metadataKind,metadataName,formName,targetForm,timeout", "dataProcessor",
			CTB_ОбязательноеПоле(Шаг, "metadataName"), CTB_Получить(Шаг, "formName", "Форма"),
			CTB_ОбязательноеПоле(Шаг, "targetForm"), CTB_Таймаут(Шаг));
		Возврат CTB_ОткрытьФормуЧерезТестКлиент(ТестКлиент, ШагОткрытия, СохраненныеОбъекты);
	ИначеЕсли Действие = "openform" Тогда
		Возврат CTB_ОткрытьФормуЧерезТестКлиент(ТестКлиент, Шаг, СохраненныеОбъекты);
	ИначеЕсли Действие = "opentaskexecutionform" Тогда
		Возврат CTB_ОткрытьФормуВыполненияЗадачи(ТестКлиент, Шаг, СохраненныеОбъекты);
	ИначеЕсли Действие = "executecommand" Тогда
		Окно = ТестКлиент.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"),,, CTB_Таймаут(Шаг));
		Если Окно = Неопределено Тогда
			ВызватьИсключение "Main client window was not found";
		КонецЕсли;
		Окно.ВыполнитьКоманду(CTB_ОбязательноеПоле(Шаг, "command"));
		Возврат Неопределено;
	ИначеЕсли Действие = "nextwindow" Тогда
		Окно = CTB_АктивноеОкно(ТестКлиент, Шаг);
		Окно.ПерейтиКСледующемуОкну();
		Возврат Неопределено;
	ИначеЕсли Действие = "activatewindow" Тогда
		Окно = CTB_АктивноеОкно(ТестКлиент, Шаг);
		Окно.Активизировать();
		Возврат Неопределено;
	ИначеЕсли Действие = "waitform" Тогда
		Форма = CTB_НайтиФорму(ТестКлиент, Шаг);
		CTB_СохранитьОбъект(Шаг, Форма, СохраненныеОбъекты);
		Возврат CTB_Получить(Шаг, "title", CTB_Получить(Шаг, "objectName", ""));
	ИначеЕсли Действие = "waitformclosed" Тогда
		ПсевдонимФормы = Строка(CTB_ОбязательноеПоле(Шаг, "form"));
		Форма = СохраненныеОбъекты.Получить(ПсевдонимФормы);
		Если Форма = Неопределено Тогда
			ВызватьИсключение "Saved form was not found: " + ПсевдонимФормы;
		КонецЕсли;
		Возврат CTB_ОжидатьЗакрытияФормы(ТестКлиент, Форма, Шаг);
	ИначеЕсли Действие = "waitelement" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Возврат CTB_ОжидатьЭлемент(ТестКлиент, Форма, Шаг);
	ИначеЕсли Действие = "assertelement" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Возврат CTB_ПроверитьЭлемент(Форма, Шаг);
	ИначеЕсли Действие = "inspectui" Тогда
		Если ПустаяСтрока(CTB_Получить(Шаг, "form", "")) Тогда
			КореньUI = CTB_ГлавноеОкно(ТестКлиент, Шаг);
		Иначе
			КореньUI = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		КонецЕсли;
		Возврат CTB_ОписатьДеревоUI(КореньUI, CTB_Получить(Шаг, "depth", 4));
	ИначеЕсли Действие = "inspectcommandinterface" Тогда
		Окно = CTB_ОкноКомандногоИнтерфейса(ТестКлиент, Шаг, СохраненныеОбъекты);
		Возврат CTB_ОписатьДеревоUI(Окно.ПолучитьКомандныйИнтерфейс(), CTB_Получить(Шаг, "depth", 6));
	ИначеЕсли Действие = "clickcommandinterface" Тогда
		Окно = CTB_ОкноКомандногоИнтерфейса(ТестКлиент, Шаг, СохраненныеОбъекты);
		Интерфейс = Окно.ПолучитьКомандныйИнтерфейс();
		КнопкаИнтерфейса = CTB_НайтиОбъект(Интерфейс, "ТестируемаяКнопкаКомандногоИнтерфейса", CTB_Получить(Шаг, "button", Шаг));
		КнопкаИнтерфейса.Нажать();
		Возврат Неопределено;
	ИначеЕсли Действие = "activateform" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Форма.Активизировать();
		Возврат Неопределено;
	ИначеЕсли Действие = "activateelement" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Элемент = CTB_ПолучитьЭлемент(Форма, Шаг);
		Элемент.Активизировать();
		Возврат CTB_ОписатьСостояниеЭлемента(Элемент);
	ИначеЕсли Действие = "clickelement" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Элемент = CTB_ПолучитьЭлемент(Форма, Шаг);
		CTB_НажатьЭлементФормы(ТестКлиент, Элемент, CTB_Получить(Шаг, "elementType", ""));
		Возврат Неопределено;
	ИначеЕсли Действие = "inputtext" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Поле = CTB_НайтиОбъект(Форма, "ТестируемоеПолеФормы", CTB_Получить(Шаг, "field", Шаг));
		CTB_ПроверитьДоступностьПоляДляВвода(Поле);
		Поле.Активизировать();
		Поле.ВвестиТекст(Строка(CTB_ОбязательноеПоле(Шаг, "value")));
		Возврат Неопределено;
	ИначеЕсли Действие = "selectfromdropdown" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Поле = CTB_НайтиОбъект(Форма, "ТестируемоеПолеФормы", CTB_Получить(Шаг, "field", Шаг));
		Возврат CTB_ВыбратьИзВыпадающегоСписка(Поле, Шаг);
	ИначеЕсли Действие = "selectreference" Тогда
		Возврат CTB_ВыбратьСсылку(ТестКлиент, Шаг, СохраненныеОбъекты);
	ИначеЕсли Действие = "setcheckbox" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Поле = CTB_НайтиОбъект(Форма, "ТестируемоеПолеФормы", CTB_Получить(Шаг, "field", Шаг));
		Поле.Активизировать();
		Если CTB_Получить(Шаг, "checked", Истина) Тогда
			Поле.УстановитьОтметку();
		Иначе
			Поле.СнятьОтметку();
		КонецЕсли;
		Возврат Поле.ПолучитьПредставлениеДанных();
	ИначеЕсли Действие = "openchoice" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		ТабличныйКонтекст = CTB_Получить(Шаг, "table", Неопределено) <> Неопределено;
		КонтекстПоля = CTB_ПолучитьКонтекстПоля(Форма, Шаг, ТабличныйКонтекст, ТабличныйКонтекст);
		ОписаниеФормыВыбора = CTB_Получить(Шаг, "choiceForm", Новый Структура);
		ФормаВыбора = CTB_ОткрытьФормуВыбора(ТестКлиент, Форма, КонтекстПоля, ОписаниеФормыВыбора);
		CTB_СохранитьОбъект(Шаг, ФормаВыбора, СохраненныеОбъекты);
		Возврат CTB_ИмяФормы(ФормаВыбора);
	ИначеЕсли Действие = "selecttablerow" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Таблица = CTB_НайтиОбъект(Форма, "ТестируемаяТаблицаФормы", CTB_Получить(Шаг, "table", Шаг));
		Возврат CTB_ВыбратьСтрокуТаблицы(Таблица, Шаг);
	ИначеЕсли Действие = "expandtreerow" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Таблица = CTB_НайтиОбъект(Форма, "ТестируемаяТаблицаФормы", CTB_Получить(Шаг, "table", Шаг));
		Возврат CTB_РазвернутьСтрокуДерева(Таблица, Шаг);
	ИначеЕсли Действие = "presskey" Тогда
		ОшибкиUIA = Новый Массив;
		Если Не CTB_ЗапроситьUIAКлавишу(ТестКлиент, Строка(CTB_ОбязательноеПоле(Шаг, "key")), ОшибкиUIA) Тогда
			ВызватьИсключение "UI key was not sent: " + СтрСоединить(ОшибкиUIA, "; ");
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Действие = "asserttablerow" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Таблица = CTB_НайтиОбъект(Форма, "ТестируемаяТаблицаФормы", CTB_Получить(Шаг, "table", Шаг));
		СтрокаНайдена = CTB_ПерейтиКСтрокеТаблицы(Таблица, Шаг, Ложь);
		ОжидалосьНаличие = CTB_Получить(Шаг, "exists", Истина);
		Если СтрокаНайдена <> ОжидалосьНаличие Тогда
			ВызватьИсключение "Table row assertion failed. Expected exists: " + Строка(ОжидалосьНаличие);
		КонецЕсли;
		Возврат СтрокаНайдена;
	ИначеЕсли Действие = "inputtablecell" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		КонтекстПоля = CTB_ПолучитьКонтекстПоля(Форма, Шаг, Истина, Истина);
		CTB_ВвестиТекстВТабличноеПоле(ТестКлиент, КонтекстПоля, Шаг);
		CTB_ЗавершитьРедактированиеТаблицы(ТестКлиент, КонтекстПоля.Таблица, Шаг);
		Возврат CTB_ПолучитьТекстПоля(КонтекстПоля);
	ИначеЕсли Действие = "inspecttable" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Таблица = CTB_НайтиОбъект(Форма, "ТестируемаяТаблицаФормы", CTB_Получить(Шаг, "table", Шаг));
		Попытка
			Таблица.Активизировать();
			Таблица.ПерейтиКПервойСтроке();
		Исключение
		КонецПопытки;
		Возврат Таблица.ПолучитьВыделенныеСтроки();
	ИначеЕсли Действие = "click" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		CTB_НажатьКнопкуФормыИлиКомандногоИнтерфейса(
			ТестКлиент, Форма, Шаг, СохраненныеОбъекты);
		Возврат Неопределено;
	ИначеЕсли Действие = "invokeformcommand" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Команда = Новый Структура("formName,command", CTB_ИмяФормы(Форма), CTB_ОбязательноеПоле(Шаг, "command"));
		Возврат CTB_ВыполнитьRuntimeКомандуФормы(ТестКлиент, Шаг, Команда);
	ИначеЕсли Действие = "assertfield" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		ТабличныйКонтекст = CTB_Получить(Шаг, "table", Неопределено) <> Неопределено;
		КонтекстПоля = CTB_ПолучитьКонтекстПоля(Форма, Шаг, ТабличныйКонтекст, ТабличныйКонтекст);
		Фактическое = CTB_ПолучитьТекстПоля(КонтекстПоля);
		Если ТабличныйКонтекст Тогда
			CTB_ЗавершитьРедактированиеТаблицы(ТестКлиент, КонтекстПоля.Таблица, Шаг);
		КонецЕсли;
		Ожидаемое = Строка(CTB_ОбязательноеПоле(Шаг, "expected"));
		Если Не CTB_ТекстовыеЗначенияСовпадают(Фактическое, Ожидаемое) Тогда
			ВызватьИсключение "Field assertion failed. Expected: " + Ожидаемое + "; actual: " + Фактическое;
		КонецЕсли;
		Возврат Фактическое;
	ИначеЕсли Действие = "handledialog" Тогда
		Возврат CTB_ОбработатьДиалог(ТестКлиент, Шаг);
	ИначеЕсли Действие = "closeform" Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Попытка
			// У большинства объектных форм закрытие является командой окна, а не
			// кнопкой формы. Не расходуем общий timeout шага на ожидаемое отсутствие.
			ОписаниеКнопкиЗакрыть = Новый Структура("objectName,timeout", "Закрыть", 1);
			КнопкаЗакрыть = CTB_НайтиОбъект(Форма, "ТестируемаяКнопкаФормы", ОписаниеКнопкиЗакрыть);
			КнопкаЗакрыть.Нажать();
		Исключение
			// Для платформенных диалогов без стандартной команды формы.
			Окно = CTB_АктивноеОкно(ТестКлиент, Шаг);
			Окно.Закрыть();
		КонецПопытки;
		Если Не ПустаяСтрока(CTB_Получить(Шаг, "onPrompt", "")) Или CTB_Получить(Шаг, "dialogButton", Неопределено) <> Неопределено Тогда
			CTB_ОбработатьДиалогЗакрытия(ТестКлиент, Шаг);
		КонецЕсли;
		Если CTB_Получить(Шаг, "waitClosed", Истина) Тогда
			CTB_ОжидатьЗакрытияФормы(ТестКлиент, Форма, Шаг);
		КонецЕсли;
		Возврат Истина;
	Иначе
		ВызватьИсключение "Unsupported UI action: " + Действие;
	КонецЕсли;
КонецФункции

Функция CTB_ОткрытьФормуВыполненияЗадачи(ТестКлиент, Шаг, СохраненныеОбъекты)
	UUID = Строка(CTB_ОбязательноеПоле(Шаг, "uuid"));
	ИмяМетаданных = Строка(CTB_ОбязательноеПоле(Шаг, "metadataName"));
	ОписаниеФормы = CodexUIJobsServer.ПоместитьФормуВыполненияЗадачиВоВременноеХранилище(ИмяМетаданных, UUID);
	// Временное хранилище принадлежит сеансу TestManager и недоступно
	// TestClient. Параметры штатной формы (включая типизированный Ключ)
	// сохраняем в ресурсе регистра как ХранилищеЗначения: это переживает
	// границу сеансов и не вынуждает клиентский обработчик повторно искать
	// задачу через менеджер метаданных во время открытия формы.
	CodexUIJobsServer.СохранитьPayload(CTB_ТекущийИдентификаторЗадания, ОписаниеФормы.parameters);
	Команда = Новый Структура("formName,persistentPayload,requireFormKey",
		Строка(CTB_ОбязательноеПоле(ОписаниеФормы, "formName")), Истина, Истина);
	// This must use the same synchronous TestManager command route as openForm.
	// The former timer transport cannot run in a connected /TestClient process.
	Возврат CTB_ОткрытьФормуЧерезКомандуTestClient(ТестКлиент, Шаг, Команда, СохраненныеОбъекты);
КонецФункции

Функция CTB_ОтправитьКомандуОткрытияФормы(ТестКлиент, Шаг, Команда, СохраненныеОбъекты)
	ОткрытыеФормы = CTB_ПолучитьОткрытыеФормы(ТестКлиент);
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Команда), "client-form-request");
	// В TestClient обработчик ожидания прикладной формы исполняется только пока
	// TestManager не удерживает его RPC-сеанс. Освобождаем соединение, даём
	// клиенту открыть форму и ждём ответ через независимую bridge job. Затем
	// создаём новое TestManager -> TestClient соединение для инспекции формы.
	Попытка
		ТестКлиент.РазорватьСоединение();
	Исключение
	КонецПопытки;
	МоментОкончания = ТекущаяДата() + CTB_Таймаут(Шаг);
	Пока ТекущаяДата() <= МоментОкончания Цикл
		ОтветКлиента = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если ОтветКлиента <> Неопределено И ОтветКлиента.status = "client-form-response" Тогда
			Ответ = CTB_ПрочитатьJSONСтроку(ОтветКлиента.result);
			Если Не CTB_Получить(Ответ, "ok", Ложь) Тогда ВызватьИсключение "TestClient OpenForm failed: " + CTB_Получить(Ответ, "error", "unknown error"); КонецЕсли;
			ТестКлиент = CTB_ПереподключитьТестКлиентПослеСервернойФазы(ТестКлиент, CTB_ХостТестКлиента, CTB_ПортТестКлиента);
			CTB_ТекущийТестКлиент = ТестКлиент;
			ДиагностикаПараметров = CTB_Получить(Ответ, "parameters", Новый Структура);
			ОжидаемыйUUID = Строка(CTB_Получить(Шаг, "uuid", ""));
			ФактическийUUID = Строка(CTB_Получить(ДиагностикаПараметров, "keyUuid", ""));
			Если Не ПустаяСтрока(ОжидаемыйUUID) И Не ПустаяСтрока(ФактическийUUID)
				И НРег(ОжидаемыйUUID) <> НРег(ФактическийUUID) Тогда
				ВызватьИсключение "TestClient received a different task key. Expected " + ОжидаемыйUUID
					+ ", got " + ФактическийUUID + ": " + CTB_ЗаписатьJSONСтроку(ДиагностикаПараметров);
			КонецЕсли;
			ОписаниеЦели = CTB_ОбязательноеПоле(Шаг, "targetForm");
			Форма = CTB_ОжидатьНовуюФорму(ТестКлиент, ОписаниеЦели, ОткрытыеФормы);
			CTB_СохранитьОбъект(ОписаниеЦели, Форма, СохраненныеОбъекты);
			Возврат Новый Структура("formName,parameters", CTB_Получить(Команда, "formName", ""), ДиагностикаПараметров);
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "TestClient OpenForm response timeout";
КонецФункции

Функция CTB_ВыполнитьRuntimeКомандуФормы(ТестКлиент, Шаг, Команда)
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Команда), "client-runtime-request");
	// См. CTB_ОтправитьКомандуОткрытияФормы: runtime-команду исполняет
	// обработчик ожидания самого TestClient, поэтому на время ожидания ответа
	// нельзя удерживать TestManager RPC-сеанс.
	Попытка
		ТестКлиент.РазорватьСоединение();
	Исключение
	КонецПопытки;
	МоментОкончания = ТекущаяДата() + CTB_Таймаут(Шаг);
	Пока ТекущаяДата() <= МоментОкончания Цикл
		ОтветКлиента = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если ОтветКлиента <> Неопределено И ОтветКлиента.status = "client-runtime-response" Тогда
			Ответ = CTB_ПрочитатьJSONСтроку(ОтветКлиента.result);
			Если Не CTB_Получить(Ответ, "ok", Ложь) Тогда ВызватьИсключение "TestClient form command failed: " + CTB_Получить(Ответ, "error", "unknown error"); КонецЕсли;
			ТестКлиент = CTB_ПереподключитьТестКлиентПослеСервернойФазы(ТестКлиент, CTB_ХостТестКлиента, CTB_ПортТестКлиента);
			CTB_ТекущийТестКлиент = ТестКлиент;
			Возврат Ответ;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "TestClient form command response timeout";
КонецФункции

Процедура CTB_НажатьЭлементФормы(ТестКлиент, Элемент, ВидЭлемента)
	// Не все интерактивные элементы формы публикуют метод Нажать(). Для
	// гиперссылок и декораций используем изолированный UIA Invoke/default action;
	// это не зависит от экранных координат.
	// Вид элемента передается UI-worker-ом. Не сопоставляем Строка(ТипЗнч()):
	// TestClient локализует ее (например, "Тестируемая декорация формы").
	Если НРег(Строка(ВидЭлемента)) = "decoration" Тогда
		ОшибкиUIA = Новый Массив;
		Если CTB_ЗапроситьUIAВызовЭлемента(ТестКлиент, Элемент, ОшибкиUIA) Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение "UI decoration was not invoked: " + СтрСоединить(ОшибкиUIA, "; ");
	КонецЕсли;
	Попытка
		Элемент.Нажать();
		Возврат;
	Исключение
	КонецПопытки;
	Элемент.Активизировать();
	ОшибкиUIA = Новый Массив;
	Если Не CTB_ЗапроситьUIAКлавишу(ТестКлиент, "ENTER", ОшибкиUIA) Тогда
		ВызватьИсключение "UI element was activated but Enter was not sent: " + СтрСоединить(ОшибкиUIA, "; ");
	КонецЕсли;
КонецПроцедуры

Функция CTB_ЗапроситьUIAВызовЭлемента(ТестКлиент, Элемент, Ошибки)
	Заголовок = CTB_БезопасныйЗаголовокЭлемента(Элемент);
	ИмяЭлемента = CTB_БезопасноеИмяЭлемента(Элемент);
	Если ПустаяСтрока(Заголовок) И ПустаяСтрока(ИмяЭлемента) Тогда
		Ошибки.Добавить("uia.invokeElement: element title and name are empty");
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(CTB_ТекущийИдентификаторЗадания) Тогда
		Ошибки.Добавить("uia.invokeElement: bridge job is not available");
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Запрос = Новый Структура("status,requestId,action,title,elementName", "uia-request", ИдентификаторЗапроса, "invokeElement", Заголовок, ИмяЭлемента);
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Запрос), "uia-request");
	// UIA helper is isolated and bounded by the worker. Opening a managed form can
	// take longer than the invoke itself, so retain the TestManager request window
	// long enough to receive its bounded response.
	Для НомерПопытки = 1 По 35 Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
		Задание = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если Задание = Неопределено Или ПустаяСтрока(Задание.result) Тогда Продолжить; КонецЕсли;
		Попытка Ответ = CTB_ПрочитатьJSONСтроку(Задание.result); Исключение Продолжить; КонецПопытки;
		Если CTB_Получить(Ответ, "status", "") <> "uia-response" Или CTB_Получить(Ответ, "requestId", "") <> ИдентификаторЗапроса Тогда Продолжить; КонецЕсли;
		Если CTB_Получить(Ответ, "ok", Ложь) Тогда Возврат Истина; КонецЕсли;
		Ошибки.Добавить("uia.invokeElement: " + Строка(CTB_Получить(Ответ, "error", "failed"))); Возврат Ложь;
	КонецЦикла;
	Ошибки.Добавить("uia.invokeElement: response timeout");
	Возврат Ложь;
КонецФункции

Функция CTB_ОткрытьФормуЧерезТестКлиент(ТестКлиент, Шаг, СохраненныеОбъекты)
	ОписаниеЦелевойФормы = CTB_ОбязательноеПоле(Шаг, "targetForm");
	СсылкаКлиентскойНавигации = Строка(CTB_Получить(Шаг, "clientNavigationLink", ""));
	Если Не ПустаяСтрока(СсылкаКлиентскойНавигации) Тогда
		ПолноеИмяФормы = Строка(CTB_Получить(ОписаниеЦелевойФормы, "formName", ""));
		Команда = Новый Структура("formName,navigationLink", ПолноеИмяФормы, СсылкаКлиентскойНавигации);
	Иначе
	ИмяМетаданных = Строка(CTB_ОбязательноеПоле(Шаг, "metadataName"));
	ВидМетаданных = НРег(Строка(CTB_ОбязательноеПоле(Шаг, "metadataKind")));
	ИмяФормы = Строка(CTB_Получить(Шаг, "formName", ""));
	Префикс = Новый Соответствие;
	Префикс.Вставить("catalog", "Справочник");
	Префикс.Вставить("document", "Документ");
	Префикс.Вставить("task", "Задача");
	Префикс.Вставить("dataprocessor", "Обработка");
	Префикс.Вставить("report", "Отчет");
	Префикс.Вставить("commonform", "ОбщаяФорма");
	Если Префикс.Получить(ВидМетаданных) = Неопределено Тогда
		ВызватьИсключение "Unsupported openForm metadataKind: " + ВидМетаданных;
	КонецЕсли;
	ПолноеИмяФормы = Префикс.Получить(ВидМетаданных) + "." + ИмяМетаданных;
	Если ВидМетаданных <> "commonform" И Не ПустаяСтрока(ИмяФормы) Тогда
		ПолноеИмяФормы = ПолноеИмяФормы + ".Форма." + ИмяФормы;
	КонецЕсли;
	АдресСсылки = "";
	Если ВидМетаданных = "task" И Не ПустаяСтрока(Строка(CTB_Получить(Шаг, "uuid", ""))) Тогда
		Команда = Новый Структура("formName,taskReferenceByUuid,metadataName,uuid", ПолноеИмяФормы,
			Истина, ИмяМетаданных, Строка(CTB_Получить(Шаг, "uuid", "")));
	Иначе
		Команда = Новый Структура("formName,referenceAddress", ПолноеИмяФормы, АдресСсылки);
		КонецЕсли;
	КонецЕсли;
	Возврат CTB_ОткрытьФормуЧерезКомандуTestClient(ТестКлиент, Шаг, Команда, СохраненныеОбъекты);
КонецФункции

Функция CTB_ОткрытьФормуЧерезКомандуTestClient(ТестКлиент, Шаг, Команда, СохраненныеОбъекты)
	ОписаниеЦелевойФормы = CTB_ОбязательноеПоле(Шаг, "targetForm");
	ОткрытыеФормы = CTB_ПолучитьОткрытыеФормы(ТестКлиент);
	ПолноеИмяФормы = Строка(CTB_ОбязательноеПоле(Команда, "formName"));
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания,
		CTB_ЗаписатьJSONСтроку(Команда), "client-form-request");
	// Это не асинхронный timer transport: TestManager доставляет общую команду
	// непосредственно в TestClient штатным ВыполнитьКоманду(). Общая команда
	// читает тот же коррелированный job, открывает форму и сразу пишет ответ.
	CTB_ВыполнитьКомандуНавигации(ТестКлиент,
		"e1cib/command/ОбщаяКоманда.CodexNavigate", Шаг);
	// A client-side form can be opened before its command handler returns (for
	// example when an application error window interrupts that handler). The
	// TestManager form API is authoritative: do not turn an already opened form
	// into a false transport timeout merely because the optional acknowledgement
	// was not persisted.
	Попытка
		Форма = CTB_ОжидатьНовуюФорму(ТестКлиент, ОписаниеЦелевойФормы, ОткрытыеФормы);
		CTB_СохранитьОбъект(ОписаниеЦелевойФормы, Форма, СохраненныеОбъекты);
		Возврат ПолноеИмяФормы;
	Исключение
		// Preserve the correlated acknowledgement wait below for forms that are
		// not yet visible through the TestManager object model.
	КонецПопытки;
	МоментОкончания = ТекущаяДата() + CTB_Таймаут(Шаг);
	Пока ТекущаяДата() <= МоментОкончания Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
		ОтветКлиента = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если ОтветКлиента <> Неопределено И ОтветКлиента.status = "client-form-response" Тогда
			Ответ = CTB_ПрочитатьJSONСтроку(ОтветКлиента.result);
			Если Не CTB_Получить(Ответ, "ok", Ложь) Тогда
				ВызватьИсключение "TestClient OpenForm failed: " + CTB_Получить(Ответ, "error", "unknown error");
			КонецЕсли;
			// Некоторые рабочие области ERP визуально открываются, но не входят в
			// корневую коллекцию форм TestClient. В этом случае worker независимо
			// проверяет заголовок целевой вкладки через UI Automation. Без совпадения
			// цель не считается открытой.
			ОшибкиUIA = Новый Массив;
			Если Не ПустаяСтрока(Строка(CTB_Получить(ОписаниеЦелевойФормы, "title", "")))
				И CTB_ЗапроситьUIAПроверкуЦелевойФормы(ТестКлиент, ОписаниеЦелевойФормы, ОшибкиUIA) Тогда
				Возврат ПолноеИмяФормы;
			КонецЕсли;
			Форма = CTB_ОжидатьНовуюФорму(ТестКлиент, ОписаниеЦелевойФормы, ОткрытыеФормы);
			CTB_СохранитьОбъект(ОписаниеЦелевойФормы, Форма, СохраненныеОбъекты);
			Возврат ПолноеИмяФормы;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "TestClient did not acknowledge OpenForm within timeout: " + ПолноеИмяФормы;
КонецФункции

Функция CTB_ЗапроситьUIAПроверкуЦелевойФормы(ТестКлиент, ОписаниеЦели, Ошибки)
	Если ПустаяСтрока(CTB_ТекущийИдентификаторЗадания) Тогда
		Ошибки.Добавить("uia.waitForTarget: bridge job is not available");
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Запрос = Новый Структура;
	Запрос.Вставить("status", "uia-request");
	Запрос.Вставить("requestId", ИдентификаторЗапроса);
	Запрос.Вставить("action", "waitForTarget");
	Запрос.Вставить("title", CTB_Получить(ОписаниеЦели, "title", ""));
	Запрос.Вставить("timeout", CTB_Таймаут(ОписаниеЦели));
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Запрос), "uia-request");
	Для НомерПопытки = 1 По CTB_Таймаут(ОписаниеЦели) + 5 Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
		Задание = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если Задание = Неопределено Или ПустаяСтрока(Задание.result) Тогда
			Продолжить;
		КонецЕсли;
		Попытка Ответ = CTB_ПрочитатьJSONСтроку(Задание.result); Исключение Продолжить; КонецПопытки;
		Если CTB_Получить(Ответ, "status", "") <> "uia-response" Или CTB_Получить(Ответ, "requestId", "") <> ИдентификаторЗапроса Тогда
			Продолжить;
		КонецЕсли;
		Если CTB_Получить(Ответ, "ok", Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
		Ошибки.Добавить("uia.waitForTarget: " + Строка(CTB_Получить(Ответ, "error", "failed")));
		Возврат Ложь;
	КонецЦикла;
	Ошибки.Добавить("uia.waitForTarget: response timeout");
	Возврат Ложь;
КонецФункции

Функция CTB_ОткрытьНавигационнуюЦель(ТестКлиент, Шаг, Ссылка, СохраненныеОбъекты)
	ОписаниеЦелевойФормы = CTB_Получить(Шаг, "targetForm", Неопределено);
	Если ОписаниеЦелевойФормы = Неопределено Тогда
		ВызватьИсключение "Navigation action requires targetForm: " + Ссылка;
	КонецЕсли;
	Если ПустаяСтрока(Строка(CTB_Получить(ОписаниеЦелевойФормы, "formName", "")))
		И ПустаяСтрока(Строка(CTB_Получить(ОписаниеЦелевойФормы, "objectName", "")))
		И ПустаяСтрока(Строка(CTB_Получить(ОписаниеЦелевойФормы, "title", ""))) Тогда
		ВызватьИсключение "targetForm requires formName, objectName, or title: " + Ссылка;
	КонецЕсли;
	КоличествоПопыток = Число(CTB_Получить(Шаг, "attempts", 3));
	СохраненныеОбъекты.Вставить("__CTB_BeforeNavigation", CTB_СобратьДиагностикуФорм(ТестКлиент));
	ОткрытыеФормы = CTB_ПолучитьОткрытыеФормы(ТестКлиент);
	ТекстОшибки = "";
	КомандаПринята = Ложь;
	Для НомерПопытки = 1 По КоличествоПопыток Цикл
		Попытка
			CTB_ВыполнитьКомандуНавигации(ТестКлиент, Ссылка, Шаг);
			КомандаПринята = Истина;
			Прервать;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			CTB_ПаузаТестКлиента(ТестКлиент);
		КонецПопытки;
	КонецЦикла;
	Если Не КомандаПринята Тогда
		ВызватьИсключение "Navigation command was rejected after " + КоличествоПопыток
			+ " attempts: " + Ссылка + ". " + ТекстОшибки;
	КонецЕсли;
	// Некоторые специальные формы ERP (включая задачу исполнителя) закрывают
	// RPC-канал объекта TestClient сразу после принятия navigation-команды.
	// Сам TestClient продолжает слушать тот же порт, поэтому пересоздаем только
	// объект подключения до первой инспекции формы.
	Попытка
		ТестКлиент = CTB_ВосстановитьСоединениеТестКлиента(ТестКлиент, CTB_ХостТестКлиента, CTB_ПортТестКлиента);
	Исключение
		ВызватьИсключение "TestClient connection was lost after navigation: " + ОписаниеОшибки();
	КонецПопытки;
	Форма = CTB_ОжидатьНовуюФорму(ТестКлиент, ОписаниеЦелевойФормы, ОткрытыеФормы);
	CTB_ПроверитьЧтоФормаНеОшибкаНавигации(Форма, Ссылка);
	CTB_СохранитьОбъект(ОписаниеЦелевойФормы, Форма, СохраненныеОбъекты);
	Возврат Ссылка;
КонецФункции

Процедура CTB_ПроверитьЧтоФормаНеОшибкаНавигации(Форма, Ссылка)
	Заголовок = "";
	ИмяФормы = "";
	Попытка Заголовок = НРег(Строка(Форма.ТекстЗаголовка)); Исключение КонецПопытки;
	Попытка ИмяФормы = НРег(CTB_ИмяФормы(Форма)); Исключение КонецПопытки;
	Если СтрНайти(Заголовок, "ошибк") > 0 Или СтрНайти(Заголовок, "не удалось перейти") > 0
		Или СтрНайти(ИмяФормы, "ошибка") > 0 Или СтрНайти(ИмяФормы, "error") > 0 Тогда
		ВызватьИсключение "Navigation opened an error form instead of target: " + Ссылка;
	КонецЕсли;
КонецПроцедуры

Функция CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты)
	Псевдоним = CTB_Получить(Шаг, "form", "");
	Если Не ПустаяСтрока(Псевдоним) Тогда
		Форма = СохраненныеОбъекты.Получить(Псевдоним);
		Если Форма = Неопределено Тогда
			ВызватьИсключение "Saved form was not found: " + Псевдоним;
		КонецЕсли;
		Возврат Форма;
	КонецЕсли;
	Окно = CTB_АктивноеОкно(ТестКлиент, Шаг);
	Возврат CTB_НайтиФорму(ТестКлиент, Шаг);
КонецФункции

Функция CTB_ОкноКомандногоИнтерфейса(ТестКлиент, Шаг, СохраненныеОбъекты)
	// Командный интерфейс принадлежит окну клиентского приложения, а не элементу
	// формы. Если форма сохранена под псевдонимом, сначала активируем именно её:
	// это делает действие применимым и к панели команд формы, и к главному окну.
	ПсевдонимФормы = CTB_Получить(Шаг, "form", "");
	Если Не ПустаяСтрока(ПсевдонимФормы) Тогда
		Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
		Форма.Активизировать();
	КонецЕсли;
	Возврат CTB_АктивноеОкно(ТестКлиент, Шаг);
КонецФункции

Процедура CTB_НажатьКнопкуФормыИлиКомандногоИнтерфейса(ТестКлиент, Форма, Шаг, СохраненныеОбъекты)
	// Команды управляемой формы платформа может одновременно отобразить как
	// ТестируемаяКнопкаФормы и как кнопку командного интерфейса окна. Для
	// прикладных команд второй объект исполняет команду формы штатно, тогда как
	// нажатие визуального представления не на всех конфигурациях вызывает её
	// обработчик. По умолчанию выбираем семантическую кнопку команды, затем
	// старое нажатие объекта TestClient. UIA Invoke разрешается только явным
	// `clickMode: uia`: при неясном ответе его нельзя автоматически повторять
	// другим способом, чтобы не выполнить прикладную команду дважды.
	ОписаниеКнопки = CTB_Получить(Шаг, "button", Шаг);
	Стратегия = НРег(Строка(CTB_Получить(Шаг, "clickMode", "auto")));
	Если Стратегия <> "form" Тогда
		КнопкаКоманды = Неопределено;
		Попытка
			Форма.Активизировать();
			Окно = CTB_ОкноКомандногоИнтерфейса(ТестКлиент, Шаг, СохраненныеОбъекты);
			Интерфейс = Окно.ПолучитьКомандныйИнтерфейс();
			КнопкаКоманды = CTB_НайтиОбъект(
				Интерфейс, "ТестируемаяКнопкаКомандногоИнтерфейса", ОписаниеКнопки);
		Исключение
			КнопкаКоманды = Неопределено;
		КонецПопытки;
		Если КнопкаКоманды <> Неопределено Тогда
			КнопкаКоманды.Нажать();
			Возврат;
		КонецЕсли;
		Если Стратегия = "command" Тогда
			ВызватьИсключение "Command-interface button was not found";
		КонецЕсли;
	КонецЕсли;
	КнопкаФормы = CTB_НайтиОбъект(Форма, "ТестируемаяКнопкаФормы", ОписаниеКнопки);
	Если Стратегия = "uia" Тогда
		ОшибкиUIA = Новый Массив;
		Если CTB_ЗапроситьUIAВызовЭлемента(ТестКлиент, КнопкаФормы, ОшибкиUIA) Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение "UI button was not invoked: " + СтрСоединить(ОшибкиUIA, "; ");
	КонецЕсли;
	КнопкаФормы.Нажать();
КонецПроцедуры

Функция CTB_ПолучитьОткрытыеФормы(ТестКлиент, ПодавлятьОшибки = Истина)
	Результат = Новый Массив;
	Попытка
		Формы = ТестКлиент.НайтиОбъекты(Тип("ТестируемаяФорма"));
		Для Каждого Форма Из Формы Цикл
			Если Результат.Найти(Форма) = Неопределено Тогда
				Результат.Добавить(Форма);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Если Не ПодавлятьОшибки Тогда
			ВызватьИсключение ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция CTB_ФормаСоответствуетОписанию(Форма, Описание)
	Заголовок = CTB_Получить(Описание, "title", "");
	Имя = CTB_Получить(Описание, "objectName", "");
	ИмяФормы = CTB_Получить(Описание, "formName", "");
	Если Не CTB_ФормаСоответствует(Форма, Заголовок, Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяФормы) И CTB_ИмяФормы(Форма) <> ИмяФормы Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция CTB_ОжидатьНовуюФорму(ТестКлиент, Описание, ФормыДоНавигации)
	МоментОкончания = ТекущаяДата() + CTB_Таймаут(Описание);
	ПоследняяОшибка = "";
	Заголовок = CTB_Получить(Описание, "title", "");
	Имя = CTB_Получить(Описание, "objectName", "");
	ИмяФормы = CTB_Получить(Описание, "formName", "");
	Если ПустаяСтрока(Заголовок) И ПустаяСтрока(Имя) Тогда
		КритерийЗаголовка = "__CTB_NEW_FORM_WAIT__";
		КритерийИмени = "__CTB_NEW_FORM_WAIT__";
	Иначе
		КритерийЗаголовка = ?(ПустаяСтрока(Заголовок), Неопределено, Заголовок);
		КритерийИмени = ?(ПустаяСтрока(Имя), Неопределено, Имя);
	КонецЕсли;
	ИнтервалОжидания = Число(CTB_Получить(Описание, "pollingInterval", 5));
	Пока ТекущаяДата() <= МоментОкончания Цикл
		Попытка
			// В ERP форма задачи может временно разорвать RPC именно на штатном
			// ОжидатьОтображениеОбъекта с фиктивным селектором. Для formName-only
			// цели этот вызов не ищет форму всё равно: ниже она проверяется по
			// фактическому имени. Поэтому используем короткую паузу TestClient.
			Если Не ПустаяСтрока(ИмяФормы) И ПустаяСтрока(Заголовок) И ПустаяСтрока(Имя) Тогда
				CTB_ПаузаТестКлиента(ТестКлиент);
			Иначе
				ОсталосьСекунд = МоментОкончания - ТекущаяДата();
				ТаймаутОжидания = Мин(ИнтервалОжидания, Макс(1, ОсталосьСекунд));
			// Штатный wait TestClient не обрывает протокол частыми запросами во время
			// тяжелого ПриОткрытии. Для formName-only используются заведомо
			// несовпадающие критерии как безопасная пауза перед одной инспекцией.
				ТестКлиент.ОжидатьОтображениеОбъекта(
					Тип("ТестируемаяФорма"), КритерийЗаголовка, КритерийИмени, ТаймаутОжидания);
			КонецЕсли;
			// В тонком клиенте ERP форма, открытая в рабочей области, не всегда
			// попадает в корневой список форм TestClient. Активное окно при этом
			// уже содержит её, поэтому после штатного ожидания ищем и в нём.
			// Это также проверяет фактическую цель, а не только принятие команды.
			АктивноеОкно = ТестКлиент.ПолучитьАктивноеОкно();
			Если АктивноеОкно <> Неопределено Тогда
				ФормаАктивногоОкна = CTB_НайтиФормуВКонтейнере(АктивноеОкно, Описание, 1, Неопределено);
				Если ФормаАктивногоОкна <> Неопределено Тогда
					CTB_ПроверитьЧтоФормаНеОшибкаНавигации(ФормаАктивногоОкна, "target form");
					Возврат ФормаАктивногоОкна;
				КонецЕсли;
			КонецЕсли;
			Формы = CTB_ПолучитьОткрытыеФормы(ТестКлиент, Ложь);
			Для ОбратныйИндекс = 0 По Формы.Количество() - 1 Цикл
				Индекс = Формы.Количество() - 1 - ОбратныйИндекс;
				Форма = Формы[Индекс];
				Если ФормыДоНавигации.Найти(Форма) = Неопределено Тогда
					CTB_ПроверитьЧтоФормаНеОшибкаНавигации(Форма, "target form");
					Если CTB_ФормаСоответствуетОписанию(Форма, Описание) Тогда
						Возврат Форма;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
			Если СтрНайти(ПоследняяОшибка, "Navigation opened an error form instead of target") > 0 Тогда
				ВызватьИсключение ПоследняяОшибка;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "New target form was not found within timeout. Last transient TestClient error: " + ПоследняяОшибка;
КонецФункции

Функция CTB_НайтиФорму(ТестКлиент, Описание, ИсключитьФорму = Неопределено)
	// Текущую форму сначала ищем внутри активного окна. Пустые критерии поиска
	// передаются как Неопределено, а не как фильтр по пустой строке.
	АктивноеОкно = ТестКлиент.ПолучитьАктивноеОкно();
	Если АктивноеОкно <> Неопределено Тогда
		Форма = CTB_НайтиФормуВКонтейнере(АктивноеОкно, Описание, CTB_Таймаут(Описание), ИсключитьФорму);
		Если Форма <> Неопределено Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЕсли;

	// Поиск на уровне приложения и остальных окон нужен для фоновых вкладок
	// и платформенных диалогов.
	Форма = CTB_НайтиФормуВКонтейнере(ТестКлиент, Описание, 1, ИсключитьФорму);
	Если Форма <> Неопределено Тогда
		Возврат Форма;
	КонецЕсли;

	Окна = ТестКлиент.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
	Для Индекс = 0 По Окна.Количество() - 1 Цикл
		Окно = Окна[Окна.Количество() - 1 - Индекс];
		Форма = CTB_НайтиФормуВКонтейнере(Окно, Описание, 1, ИсключитьФорму);
		Если Форма <> Неопределено Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЦикла;

	Заголовок = CTB_Получить(Описание, "title", "");
	Имя = CTB_Получить(Описание, "objectName", "");
	ИмяФормы = CTB_Получить(Описание, "formName", "");
	ВызватьИсключение "Testable form was not found. Title: " + Заголовок
		+ "; name: " + Имя + "; formName: " + ИмяФормы;
КонецФункции

Функция CTB_НайтиФормуВКонтейнере(Контейнер, Описание, Таймаут, ИсключитьФорму)
	Заголовок = CTB_Получить(Описание, "title", "");
	Имя = CTB_Получить(Описание, "objectName", "");
	ИмяФормы = CTB_Получить(Описание, "formName", "");
	Если ПустаяСтрока(ИмяФормы) Тогда
		КритерийЗаголовка = ?(ПустаяСтрока(Заголовок), Неопределено, Заголовок);
		КритерийИмени = ?(ПустаяСтрока(Имя), Неопределено, Имя);
		Попытка
			Форма = Контейнер.НайтиОбъект(Тип("ТестируемаяФорма"), КритерийЗаголовка, КритерийИмени, Таймаут);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		Если Форма <> Неопределено И Форма <> ИсключитьФорму Тогда
			Возврат Форма;
		КонецЕсли;
		Если ИсключитьФорму <> Неопределено Тогда
			Попытка
				Формы = Контейнер.НайтиОбъекты(Тип("ТестируемаяФорма"));
				Для Каждого Форма Из Формы Цикл
					Если Форма <> ИсключитьФорму И CTB_ФормаСоответствует(Форма, Заголовок, Имя) Тогда
						Возврат Форма;
					КонецЕсли;
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Контейнер.НайтиОбъект(Тип("ТестируемаяФорма"),,, Таймаут);
		Формы = Контейнер.НайтиОбъекты(Тип("ТестируемаяФорма"));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Для Каждого Форма Из Формы Цикл
		Если Форма <> ИсключитьФорму И CTB_ИмяФормы(Форма) = ИмяФормы Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция CTB_ГлавноеОкно(ТестКлиент, Описание)
	Окна = ТестКлиент.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
	Для Каждого Окно Из Окна Цикл
		Попытка
			Если Окно.Основное И CTB_ОкноПригодноДляНавигации(Окно) Тогда
				Возврат Окно;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Для Каждого Окно Из Окна Цикл
		Попытка
			Если CTB_ОкноПригодноДляНавигации(Окно) Тогда
				Возврат Окно;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Попытка
		АктивноеОкно = ТестКлиент.ПолучитьАктивноеОкно();
		Если АктивноеОкно <> Неопределено И CTB_ОкноПригодноДляНавигации(АктивноеОкно) Тогда
			Возврат АктивноеОкно;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Окно = ТестКлиент.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"),,, CTB_Таймаут(Описание));
	Если Окно = Неопределено Тогда
		ВызватьИсключение "Main client window was not found";
	КонецЕсли;
	Возврат Окно;
КонецФункции

Процедура CTB_ВыполнитьКомандуНавигации(ТестКлиент, Ссылка, Описание)
	ОшибкиНавигации = Новый Массив;
	Попытка
		ТестКлиент.ВыполнитьКоманду(Ссылка);
		Возврат;
	Исключение
		ОшибкиНавигации.Добавить("application.ExecuteCommand: " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		ТестКлиент.ОткрытьНавигационнуюСсылку(Ссылка);
		Возврат;
	Исключение
		ОшибкиНавигации.Добавить("application.OpenNavigationLink: " + ОписаниеОшибки());
	КонецПопытки;
	Окна = ТестКлиент.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
	НомерОкна = 0;
	Для Каждого Окно Из Окна Цикл
		НомерОкна = НомерОкна + 1;
		Попытка
			Если CTB_ОкноПригодноДляНавигации(Окно) Тогда
				Окно.ВыполнитьКоманду(Ссылка);
				Возврат;
			КонецЕсли;
		Исключение
			ОшибкиНавигации.Добавить("window[" + Строка(НомерОкна) + "].ExecuteCommand: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Попытка
		Окно = CTB_ГлавноеОкно(ТестКлиент, Описание);
		Окно.ВыполнитьКоманду(Ссылка);
		Возврат;
	Исключение
		ОшибкиНавигации.Добавить("mainWindow.ExecuteCommand: " + ОписаниеОшибки());
	КонецПопытки;
	ВызватьИсключение CTB_СоединитьСтроки(ОшибкиНавигации, " | ");
КонецПроцедуры

Функция CTB_ОкноПригодноДляНавигации(Окно)
	НашлиПодчиненные = Ложь;
	Попытка
		Подчиненные = Окно.ПолучитьПодчиненныеОбъекты();
	Исключение
		Попытка
			Подчиненные = Окно.ПолучитьДочерниеОбъекты();
		Исключение
			Возврат Истина;
		КонецПопытки;
	КонецПопытки;
	Для Каждого ОбъектUI Из Подчиненные Цикл
		НашлиПодчиненные = Истина;
		Попытка
			Если ОбъектUI.ИмяФормы = "ОбщаяФорма.Вопрос" Тогда
				Возврат Ложь;
			КонецЕсли;
			Если ОбъектUI.ИмяФормы = "ОбщаяФорма.ПустойРабочийСтол" Тогда
				Возврат Истина;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция CTB_ФормаСоответствует(Форма, Заголовок, Имя)
	Если Не ПустаяСтрока(Имя) Тогда
		Попытка
			Если Форма.Имя <> Имя Тогда
				Возврат Ложь;
			КонецЕсли;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	Если Не ПустаяСтрока(Заголовок) Тогда
		Попытка
			Если Форма.ТекстЗаголовка <> Заголовок Тогда
				Возврат Ложь;
			КонецЕсли;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция CTB_ИмяФормы(Форма)
	Попытка
		Возврат Форма.ИмяФормы;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция CTB_ПолучитьКонтекстПоля(Форма, Шаг, ТабличныйКонтекст = Ложь, ДляРедактирования = Ложь)
	Если Не ТабличныйКонтекст Тогда
		Поле = CTB_НайтиОбъект(Форма, "ТестируемоеПолеФормы", CTB_Получить(Шаг, "field", Шаг));
		Поле.Активизировать();
		Возврат Новый Структура("Форма,Поле,Таблица,Табличный", Форма, Поле, Неопределено, Ложь);
	КонецЕсли;

	Таблица = CTB_НайтиОбъект(Форма, "ТестируемаяТаблицаФормы", CTB_ОбязательноеПоле(Шаг, "table"));
	// Активация таблицы обязательна: активация родительской страницы не всегда
	// визуально переключает вкладку управляемой формы.
	Таблица.Активизировать();
	Если CTB_Получить(Шаг, "row", Неопределено) <> Неопределено Тогда
		Если Не CTB_ПерейтиКСтрокеТаблицы(Таблица, Шаг) Тогда
			ВызватьИсключение "Table row was not found";
		КонецЕсли;
	КонецЕсли;

	Поле = CTB_НайтиОбъект(Таблица, "ТестируемоеПолеФормы", CTB_Получить(Шаг, "field", Шаг));
	// Сначала активируется конкретная ячейка, затем строка переводится в режим
	// редактирования. Такой порядок устойчивее для ссылочных колонок таблиц.
	Поле.Активизировать();
	Если ДляРедактирования Тогда
		CTB_ПодготовитьТабличнуюСтрокуКРедактированию(Таблица, Поле, Шаг);
	КонецЕсли;
	Поле.Активизировать();
	Возврат Новый Структура("Форма,Поле,Таблица,Табличный", Форма, Поле, Таблица, Истина);
КонецФункции

Процедура CTB_АктивизироватьФормуПоля(КонтекстПоля)
	Попытка
		КонтекстПоля.Форма.Активизировать();
	Исключение
	КонецПопытки;
	Если КонтекстПоля.Табличный Тогда
		Попытка
			КонтекстПоля.Таблица.Активизировать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Попытка
		КонтекстПоля.Поле.Активизировать();
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура CTB_ПодготовитьТабличнуюСтрокуКРедактированию(Таблица, Поле, Шаг)
	// В разных конфигурациях и версиях платформы ТекущийРежимРедактирование()
	// может оставаться Ложь даже после успешного входа в редактирование ячейки.
	// Поэтому здесь только подготавливаем строку несколькими безопасными способами,
	// а точную ошибку отдаёт последующее действие над полем.
	Если Не Таблица.ТекущийРежимРедактирование() Тогда
		Попытка
			Таблица.ИзменитьСтроку();
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Режим редактирования строки ещё не означает, что редактор текущей ячейки
	// создан. Для полей табличной части ВвестиТекст() работает именно после
	// явного входа в редактирование текущей области. Это требуется и когда строка
	// уже была переведена в режим редактирования предыдущим UI-действием.
	Попытка
		Поле.Активизировать();
		Поле.НачатьРедактированиеТекущейОбласти();
	Исключение
	КонецПопытки;
	Если Не Таблица.ТекущийРежимРедактирование() Тогда
		Попытка
			Поле.Активизировать();
			Таблица.ИзменитьСтроку();
			Поле.Активизировать();
			Поле.НачатьРедактированиеТекущейОбласти();
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Функция CTB_ПолучитьТекстПоля(КонтекстПоля)
	Поле = КонтекстПоля.Поле;
	Если КонтекстПоля.Табличный Тогда
		Таблица = КонтекстПоля.Таблица;
		Попытка
			ТекстЯчейки = Таблица.ПолучитьТекстЯчейки(Поле.Имя);
			Если Не ПустаяСтрока(ТекстЯчейки) Тогда
				Возврат ТекстЯчейки;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			ТекущийЭлемент = Таблица.ПолучитьТекущийЭлемент();
			ТекстЯчейки = ТекущийЭлемент.ПолучитьПредставлениеДанных();
			Если Не ПустаяСтрока(ТекстЯчейки) Тогда
				Возврат ТекстЯчейки;
			КонецЕсли;
			Возврат ТекущийЭлемент.ПолучитьОтображаемыйТекст();
		Исключение
		КонецПопытки;
		Попытка
			Возврат Поле.ПолучитьТекстРедактирования();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Попытка
		Возврат Поле.ПолучитьОтображаемыйТекст();
	Исключение
		Возврат Поле.ПолучитьПредставлениеДанных();
	КонецПопытки;
КонецФункции

Процедура CTB_ВвестиТекстВТабличноеПоле(ТестКлиент, КонтекстПоля, Шаг)
	Значение = Строка(CTB_ОбязательноеПоле(Шаг, "value"));
	КоличествоПопыток = Число(CTB_Получить(Шаг, "attempts", 3));
	Если КоличествоПопыток < 1 Тогда
		КоличествоПопыток = 1;
	КонецЕсли;
	ТекстОшибки = "";
	Для НомерПопытки = 1 По КоличествоПопыток Цикл
		Попытка
			CTB_АктивизироватьФормуПоля(КонтекстПоля);
			КонтекстПоля.Поле.Активизировать();
			Если CTB_Получить(Шаг, "replace", Истина) Тогда
				Попытка
					КонтекстПоля.Поле.Очистить();
				Исключение
				КонецПопытки;
			КонецЕсли;
			КонтекстПоля.Поле.ВвестиТекст(Значение);
			Возврат;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		Попытка
			CTB_АктивизироватьФормуПоля(КонтекстПоля);
			ТекущийЭлемент = КонтекстПоля.Таблица.ПолучитьТекущийЭлемент();
			ТекущийЭлемент.ВвестиТекст(Значение);
			Если CTB_ТекстовыеЗначенияСовпадают(CTB_ПолучитьТекстПоля(КонтекстПоля), Значение) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ТекстОшибки = ТекстОшибки + " currentElement.InputText: " + ОписаниеОшибки();
		КонецПопытки;
		Попытка
			CTB_АктивизироватьФормуПоля(КонтекстПоля);
			КонтекстПоля.Таблица.НажатьКлавишу("F2");
			ТекущийЭлемент = КонтекстПоля.Таблица.ПолучитьТекущийЭлемент();
			ТекущийЭлемент.ВвестиТекст(Значение);
			Если CTB_ТекстовыеЗначенияСовпадают(CTB_ПолучитьТекстПоля(КонтекстПоля), Значение) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ТекстОшибки = ТекстОшибки + " table.F2CurrentElementInputText: " + ОписаниеОшибки();
		КонецПопытки;
		Попытка
			CTB_АктивизироватьФормуПоля(КонтекстПоля);
			КонтекстПоля.Таблица.НажатьКлавишу("Enter");
			ТекущийЭлемент = КонтекстПоля.Таблица.ПолучитьТекущийЭлемент();
			ТекущийЭлемент.ВвестиТекст(Значение);
			Если CTB_ТекстовыеЗначенияСовпадают(CTB_ПолучитьТекстПоля(КонтекстПоля), Значение) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ТекстОшибки = ТекстОшибки + " table.EnterCurrentElementInputText: " + ОписаниеОшибки();
		КонецПопытки;
		Попытка
			CTB_АктивизироватьФормуПоля(КонтекстПоля);
			КонтекстПоля.Таблица.ВвестиТекст(Значение);
			Если CTB_ТекстовыеЗначенияСовпадают(CTB_ПолучитьТекстПоля(КонтекстПоля), Значение) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ТекстОшибки = ТекстОшибки + " table.InputText: " + ОписаниеОшибки();
		КонецПопытки;
		Попытка
			CTB_АктивизироватьФормуПоля(КонтекстПоля);
			КонтекстПоля.Таблица.УстановитьТекстЯчейки(КонтекстПоля.Поле.Имя, Значение);
			Если CTB_ТекстовыеЗначенияСовпадают(CTB_ПолучитьТекстПоля(КонтекстПоля), Значение) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ТекстОшибки = ТекстОшибки + " table.SetCellText: " + ОписаниеОшибки();
		КонецПопытки;
		Попытка
			CTB_АктивизироватьФормуПоля(КонтекстПоля);
			КонтекстПоля.Таблица.УстановитьЗначениеЯчейки(КонтекстПоля.Поле.Имя, Значение);
			Если CTB_ТекстовыеЗначенияСовпадают(CTB_ПолучитьТекстПоля(КонтекстПоля), Значение) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ТекстОшибки = ТекстОшибки + " table.SetCellValue: " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	ОшибкиUIA = Новый Массив;
	CTB_АктивизироватьФормуПоля(КонтекстПоля);
	Если CTB_ЗапроситьUIAВводТекста(ТестКлиент, КонтекстПоля, Значение, CTB_Получить(Шаг, "replace", Истина), ОшибкиUIA) Тогда
		Фактическое = CTB_ПолучитьТекстПоля(КонтекстПоля);
		Если CTB_ТекстовыеЗначенияСовпадают(Фактическое, Значение) Тогда
			Возврат;
		КонецЕсли;
		ОшибкиUIA.Добавить("uia.typeText: value was not applied. Expected: " + Значение + "; actual: " + Фактическое);
	КонецЕсли;
	ВызватьИсключение "Table cell input failed after " + КоличествоПопыток + " attempts. " + ТекстОшибки + " " + CTB_СоединитьСтроки(ОшибкиUIA, "; ");
КонецПроцедуры

Процедура CTB_ЗавершитьРедактированиеТаблицы(ТестКлиент, Таблица, Шаг)
	Если Не CTB_Получить(Шаг, "finishRow", Истина) Тогда
		Возврат;
	КонецЕсли;
	Если Таблица.ТекущийРежимРедактирование() Тогда
		Таблица.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	Если Таблица.ТекущийРежимРедактирование() Тогда
		ВызватьИсключение "Table row editing mode was not finished";
	КонецЕсли;
	СекундОжидания = Число(CTB_Получить(Шаг, "onChangeWait", 1));
	Для СекундаОжидания = 1 По СекундОжидания Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
	КонецЦикла;
КонецПроцедуры

Функция CTB_ВыбратьИзВыпадающегоСписка(Поле, Шаг, РежимПоУмолчанию = "")
	Значение = Строка(CTB_ОбязательноеПоле(Шаг, "value"));
	Режим = НРег(?(ПустаяСтрока(РежимПоУмолчанию), CTB_Получить(Шаг, "match", "exact"), РежимПоУмолчанию));
	КоличествоПопыток = Число(CTB_Получить(Шаг, "attempts", 3));
	Если КоличествоПопыток < 1 Тогда
		КоличествоПопыток = 1;
	КонецЕсли;

	ТекстОшибки = "";
	Для НомерПопытки = 1 По КоличествоПопыток Цикл
		Попытка
			Поле.Активизировать();
			Если Режим = "first" Тогда
				Поле.ВвестиТекст(Значение);
			КонецЕсли;
			Если Не Поле.ВыпадающийСписокОткрыт() Тогда
				Поле.ОткрытьВыпадающийСписок();
			КонецЕсли;
			Если Не Поле.ОжидатьФормированияВыпадающегоСписка(CTB_Таймаут(Шаг)) Тогда
				ВызватьИсключение "Dropdown was not formed";
			КонецЕсли;
			Если Режим = "first" Тогда
				// После ввода строки платформа формирует список выбора. Здесь нужен
				// индекс первого элемента, а не введенное представление значения.
				Поле.ВыполнитьВыборИзСпискаВыбора(0);
			ИначеЕсли Режим = "exact" Тогда
				Поле.ВыполнитьВыборИзВыпадающегоСписка(Значение);
			Иначе
				ВызватьИсключение "Unsupported dropdown match mode: " + Режим;
			КонецЕсли;
			Возврат Поле.ПолучитьПредставлениеДанных();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Попытка
				Поле.ЗакрытьВыпадающийСписок();
			Исключение
			КонецПопытки;
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "Dropdown selection failed for value '" + Значение + "'. " + ТекстОшибки;
КонецФункции

Функция CTB_ВыбратьСсылку(ТестКлиент, Шаг, СохраненныеОбъекты)
	Форма = CTB_ПолучитьФорму(ТестКлиент, Шаг, СохраненныеОбъекты);
	Стратегия = НРег(CTB_Получить(Шаг, "strategy", "dropdownExact"));
	ТабличныйКонтекст = CTB_ЭтоТабличныйВыборСсылки(Шаг);
	КонтекстПоля = CTB_ПолучитьКонтекстПоля(Форма, Шаг, ТабличныйКонтекст, ТабличныйКонтекст);
	Поле = КонтекстПоля.Поле;
	Если Стратегия = "auto" Тогда
		Ошибки = Новый Массив;
		Попытка
			Фактическое = CTB_ВыбратьИзВыпадающегоСписка(Поле, Шаг, "exact");
			Возврат CTB_ЗавершитьВыборСсылки(ТестКлиент, КонтекстПоля, Фактическое, Шаг);
		Исключение
			Ошибки.Добавить(ОписаниеОшибки());
		КонецПопытки;
		Если ТабличныйКонтекст Тогда
			КонтекстПоля = CTB_ПолучитьКонтекстПоля(Форма, Шаг, Истина, Истина);
			Поле = КонтекстПоля.Поле;
		КонецЕсли;
		Попытка
			Фактическое = CTB_ВыбратьИзВыпадающегоСписка(Поле, Шаг, "first");
			Возврат CTB_ЗавершитьВыборСсылки(ТестКлиент, КонтекстПоля, Фактическое, Шаг);
		Исключение
			Ошибки.Добавить(ОписаниеОшибки());
		КонецПопытки;
		Если CTB_Получить(Шаг, "choiceForm", Неопределено) <> Неопределено Тогда
			Если ТабличныйКонтекст Тогда
				КонтекстПоля = CTB_ПолучитьКонтекстПоля(Форма, Шаг, Истина, Истина);
			КонецЕсли;
			Попытка
				Возврат CTB_ВыбратьСсылкуЧерезФорму(ТестКлиент, Форма, КонтекстПоля, Шаг);
			Исключение
				Ошибки.Добавить(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		ВызватьИсключение "Automatic reference selection failed: " + СтрСоединить(Ошибки, " | ");
	КонецЕсли;
	Если Стратегия = "dropdownexact" Тогда
		Фактическое = CTB_ВыбратьИзВыпадающегоСписка(Поле, Шаг, "exact");
		Возврат CTB_ЗавершитьВыборСсылки(ТестКлиент, КонтекстПоля, Фактическое, Шаг);
	ИначеЕсли Стратегия = "typeahead" Тогда
		Фактическое = CTB_ВыбратьИзВыпадающегоСписка(Поле, Шаг, "first");
		Возврат CTB_ЗавершитьВыборСсылки(ТестКлиент, КонтекстПоля, Фактическое, Шаг);
	ИначеЕсли Стратегия <> "choiceform" Тогда
		ВызватьИсключение "Unsupported reference selection strategy: " + Стратегия;
	КонецЕсли;
	Возврат CTB_ВыбратьСсылкуЧерезФорму(ТестКлиент, Форма, КонтекстПоля, Шаг);
КонецФункции


Функция CTB_ЭтоТабличныйВыборСсылки(Шаг)
	// Для обычного реквизита table/row исторически описывают таблицу формы
	// выбора. Наличие choiceTable однозначно включает новый табличный контракт.
	Если CTB_Получить(Шаг, "choiceTable", Неопределено) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если CTB_Получить(Шаг, "table", Неопределено) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат CTB_Получить(Шаг, "choiceForm", Неопределено) = Неопределено;
КонецФункции

Функция CTB_ЗавершитьВыборСсылки(ТестКлиент, КонтекстПоля, Фактическое, Шаг, СтрогоПоУмолчанию = Истина)
	Если КонтекстПоля.Табличный Тогда
		CTB_ЗавершитьРедактированиеТаблицы(ТестКлиент, КонтекстПоля.Таблица, Шаг);
		Фактическое = CTB_ПолучитьТекстПоля(КонтекстПоля);
	КонецЕсли;
	Возврат CTB_ПроверитьВыбраннуюСсылку(Фактическое, Шаг, СтрогоПоУмолчанию);
КонецФункции

Функция CTB_ВыбратьСсылкуЧерезФорму(ТестКлиент, Форма, КонтекстПоля, Шаг)
	Поле = КонтекстПоля.Поле;
	Поле.Активизировать();
	ОписаниеФормыВыбора = CTB_Получить(Шаг, "choiceForm", Новый Структура);
	ФормаВыбора = CTB_ОткрытьФормуВыбора(ТестКлиент, Форма, КонтекстПоля, ОписаниеФормыВыбора);
	Если КонтекстПоля.Табличный Тогда
		ОписаниеТаблицыВыбора = CTB_ОбязательноеПоле(Шаг, "choiceTable");
		ОписаниеСтрокиВыбора = CTB_ОбязательноеПоле(Шаг, "choiceRow");
	Иначе
		ОписаниеТаблицыВыбора = CTB_ОбязательноеПоле(Шаг, "table");
		ОписаниеСтрокиВыбора = CTB_ОбязательноеПоле(Шаг, "row");
	КонецЕсли;
	ТаблицаВыбора = CTB_НайтиОбъект(ФормаВыбора, "ТестируемаяТаблицаФормы", ОписаниеТаблицыВыбора);
	ШагВыбора = Новый Структура;
	ШагВыбора.Вставить("row", ОписаниеСтрокиВыбора);
	ШагВыбора.Вставить("direction", CTB_Получить(Шаг, "direction", "both"));
	ШагВыбора.Вставить("attempts", CTB_Получить(Шаг, "attempts", 5));
	Если Не CTB_ВыбратьСтрокуТаблицы(ТаблицаВыбора, ШагВыбора) Тогда
		ВызватьИсключение "Reference row was not selected in choice form";
	КонецЕсли;
	Фактическое = CTB_ПолучитьТекстПоля(КонтекстПоля);
	Возврат CTB_ЗавершитьВыборСсылки(ТестКлиент, КонтекстПоля, Фактическое, Шаг, Ложь);
КонецФункции

Функция CTB_ОткрытьФормуВыбора(ТестКлиент, ФормаВладелец, КонтекстПоля, ОписаниеФормыВыбора)
	Ошибки = Новый Массив;
	КороткоеОписание = CTB_ОписаниеФормыСТаймаутом(ОписаниеФормыВыбора, 5);
	Если КонтекстПоля.Табличный Тогда
		// Форма должна быть открыта самим редактором ячейки: только такой вызов
		// сохраняет владельца выбора и возвращает выбранную ссылку в строку.
		Попытка
			КонтекстПоля.Поле.Активизировать();
			КонтекстПоля.Поле.Выбрать();
			Возврат CTB_НайтиФорму(ТестКлиент, ОписаниеФормыВыбора, ФормаВладелец);
		Исключение
			Ошибки.Добавить("field.Select/wait: " + ОписаниеОшибки());
		КонецПопытки;
		// Переход к списку по метаданным полезен только как диагностика: такая
		// форма не связана с владельцем и не может считаться успешным выбором.
		Попытка
			ФормаВыбораПоТипу = CTB_ОткрытьФормуВыбораПоТипуЗначения(ТестКлиент, ФормаВладелец, КонтекстПоля, ОписаниеФормыВыбора);
			Если ФормаВыбораПоТипу <> Неопределено Тогда
				Возврат ФормаВыбораПоТипу;
			КонецЕсли;
		Исключение
			Ошибки.Добавить("metadataChoiceForm: " + ОписаниеОшибки());
		КонецПопытки;
		ВызватьИсключение "Choice form was not opened from table cell. " + CTB_СоединитьСтроки(Ошибки, " | ");
	КонецЕсли;
	Попытка
		КонтекстПоля.Поле.Активизировать();
		КонтекстПоля.Поле.Выбрать();
		Возврат CTB_НайтиФорму(ТестКлиент, КороткоеОписание, ФормаВладелец);
	Исключение
		Ошибки.Добавить("field.Select/wait: " + ОписаниеОшибки());
	КонецПопытки;
	Если КонтекстПоля.Табличный Тогда
		Попытка
			КонтекстПоля.Поле.Активизировать();
			Попытка
				КонтекстПоля.Поле.НачатьРедактированиеТекущейОбласти();
			Исключение
			КонецПопытки;
			ТекущийЭлемент = КонтекстПоля.Таблица.ПолучитьТекущийЭлемент();
			ТекущийЭлемент.Выбрать();
			Возврат CTB_НайтиФорму(ТестКлиент, КороткоеОписание, ФормаВладелец);
		Исключение
			Ошибки.Добавить("table.CurrentElement.Select/wait: " + ОписаниеОшибки());
		КонецПопытки;
		Попытка
			КонтекстПоля.Поле.Активизировать();
			КонтекстПоля.Таблица.Выбрать();
			Возврат CTB_НайтиФорму(ТестКлиент, КороткоеОписание, ФормаВладелец);
		Исключение
			Ошибки.Добавить("table.Select/wait: " + ОписаниеОшибки());
		КонецПопытки;
		Попытка
			КонтекстПоля.Поле.Активизировать();
			КонтекстПоля.Поле.НажатьКлавишу("F4");
			Возврат CTB_НайтиФорму(ТестКлиент, КороткоеОписание, ФормаВладелец);
		Исключение
			Ошибки.Добавить("field.F4/wait: " + ОписаниеОшибки());
		КонецПопытки;
		Попытка
			КонтекстПоля.Поле.Активизировать();
			КонтекстПоля.Таблица.НажатьКлавишу("F4");
			Возврат CTB_НайтиФорму(ТестКлиент, КороткоеОписание, ФормаВладелец);
		Исключение
			Ошибки.Добавить("table.F4/wait: " + ОписаниеОшибки());
		КонецПопытки;
		Попытка
			КонтекстПоля.Поле.Активизировать();
			Если CTB_ЗапроситьUIAКликКнопкиПоля(ТестКлиент, КонтекстПоля, "choice", Ошибки) Тогда
				Возврат CTB_НайтиФорму(ТестКлиент, ОписаниеФормыВыбора, ФормаВладелец);
			КонецЕсли;
		Исключение
			Ошибки.Добавить("uia.choiceButton/wait: " + ОписаниеОшибки());
		КонецПопытки;
		Попытка
			ФормаВыбораПоТипу = CTB_ОткрытьФормуВыбораПоТипуЗначения(ТестКлиент, ФормаВладелец, КонтекстПоля, ОписаниеФормыВыбора);
			Если ФормаВыбораПоТипу <> Неопределено Тогда
				Возврат ФормаВыбораПоТипу;
			КонецЕсли;
		Исключение
			Ошибки.Добавить("metadataChoiceForm: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Попытка
		Возврат CTB_НайтиФорму(ТестКлиент, ОписаниеФормыВыбора, ФормаВладелец);
	Исключение
		Ошибки.Добавить("finalWait: " + ОписаниеОшибки());
	КонецПопытки;
	ВызватьИсключение "Choice form was not opened from field. " + CTB_СоединитьСтроки(Ошибки, " | ");
КонецФункции

Функция CTB_ОткрытьФормуВыбораПоТипуЗначения(ТестКлиент, ФормаВладелец, КонтекстПоля, ОписаниеФормыВыбора)
	ПолноеИмяМетаданных = Строка(CTB_Получить(ОписаниеФормыВыбора, "metadataFullName", ""));
	ЗначениеПоля = Неопределено;
	Если ПустаяСтрока(ПолноеИмяМетаданных) Тогда
		Попытка
			ЗначениеПоля = КонтекстПоля.Поле.ПолучитьЗначение();
		Исключение
			Попытка
				ЗначениеПоля = КонтекстПоля.Таблица.ПолучитьЗначениеЯчейки(КонтекстПоля.Поле.Имя);
			Исключение
			КонецПопытки;
		КонецПопытки;
		
		ОписаниеТипа = ТипЗнч(ЗначениеПоля);
		Если ОписаниеТипа <> Тип("Строка") И ОписаниеТипа <> Тип("Число") И ОписаниеТипа <> Тип("Дата") И ОписаниеТипа <> Тип("Булево") Тогда
			Попытка
				ПолноеИмяМетаданных = ЗначениеПоля.Метаданные().ПолноеИмя();
			Исключение
				ПолноеИмяМетаданных = "";
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(ПолноеИмяМетаданных) Тогда
		ИмяПоля = CTB_БезопасноеИмяЭлемента(КонтекстПоля.Поле);
		ИмяТаблицы = "";
		Если КонтекстПоля.Табличный Тогда
			ИмяТаблицы = CTB_БезопасноеИмяЭлемента(КонтекстПоля.Таблица);
		КонецЕсли;
		ЗаголовокПоля = "";
		Попытка
			ЗаголовокПоля = КонтекстПоля.Поле.Заголовок;
		Исключение
		КонецПопытки;
		ПолноеИмяМетаданных = CodexUIJobsServer.НайтиПолноеИмяМетаданныхДляПоля(ИмяПоля, ИмяТаблицы, ЗаголовокПоля);
		Если ПустаяСтрока(ПолноеИмяМетаданных) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	НавигационнаяСсылка = "e1cib/list/" + ПолноеИмяМетаданных;
	CTB_ВыполнитьКомандуНавигации(ТестКлиент, НавигационнаяСсылка, ОписаниеФормыВыбора);
	Возврат CTB_НайтиФорму(ТестКлиент, ОписаниеФормыВыбора, ФормаВладелец);
КонецФункции

Функция CTB_ЗапроситьUIAКликКнопкиПоля(ТестКлиент, КонтекстПоля, ТипКнопки, Ошибки)
	Если ПустаяСтрока(CTB_ТекущийИдентификаторЗадания) Тогда
		Ошибки.Добавить("uia." + ТипКнопки + ": bridge job is not available");
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Запрос = Новый Структура;
	Запрос.Вставить("status", "uia-request");
	Запрос.Вставить("requestId", ИдентификаторЗапроса);
	Запрос.Вставить("action", "clickActiveFieldButton");
	Запрос.Вставить("buttonKind", ТипКнопки);
	Запрос.Вставить("fieldName", CTB_БезопасноеИмяЭлемента(КонтекстПоля.Поле));
	Запрос.Вставить("fieldTitle", CTB_БезопасныйЗаголовокЭлемента(КонтекстПоля.Поле));
	Если КонтекстПоля.Табличный Тогда
		Запрос.Вставить("tableName", CTB_БезопасноеИмяЭлемента(КонтекстПоля.Таблица));
		Запрос.Вставить("tableTitle", CTB_БезопасныйЗаголовокЭлемента(КонтекстПоля.Таблица));
	КонецЕсли;
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Запрос), "uia-request");
	Для НомерПопытки = 1 По 30 Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
		Задание = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если Задание = Неопределено Или ПустаяСтрока(Задание.result) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Ответ = CTB_ПрочитатьJSONСтроку(Задание.result);
		Исключение
			Продолжить;
		КонецПопытки;
		Если CTB_Получить(Ответ, "status", "") <> "uia-response" Тогда
			Продолжить;
		КонецЕсли;
		Если CTB_Получить(Ответ, "requestId", "") <> ИдентификаторЗапроса Тогда
			Продолжить;
		КонецЕсли;
		Если CTB_Получить(Ответ, "ok", Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
		Ошибки.Добавить("uia." + ТипКнопки + ": " + Строка(CTB_Получить(Ответ, "error", "failed")));
		Возврат Ложь;
	КонецЦикла;
	Ошибки.Добавить("uia." + ТипКнопки + ": response timeout");
	Возврат Ложь;
КонецФункции

Функция CTB_ЗапроситьUIAВводТекста(ТестКлиент, КонтекстПоля, Значение, Заменять, Ошибки)
	Если ПустаяСтрока(CTB_ТекущийИдентификаторЗадания) Тогда
		Ошибки.Добавить("uia.typeText: bridge job is not available");
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Запрос = Новый Структура;
	Запрос.Вставить("status", "uia-request");
	Запрос.Вставить("requestId", ИдентификаторЗапроса);
	Запрос.Вставить("action", "typeActiveFieldText");
	Запрос.Вставить("value", Значение);
	Запрос.Вставить("replace", Заменять);
	Запрос.Вставить("fieldName", CTB_БезопасноеИмяЭлемента(КонтекстПоля.Поле));
	Запрос.Вставить("fieldTitle", CTB_БезопасныйЗаголовокЭлемента(КонтекстПоля.Поле));
	Если КонтекстПоля.Табличный Тогда
		Запрос.Вставить("tableName", CTB_БезопасноеИмяЭлемента(КонтекстПоля.Таблица));
		Запрос.Вставить("tableTitle", CTB_БезопасныйЗаголовокЭлемента(КонтекстПоля.Таблица));
	КонецЕсли;
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Запрос), "uia-request");
	Для НомерПопытки = 1 По 30 Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
		Задание = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если Задание = Неопределено Или ПустаяСтрока(Задание.result) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Ответ = CTB_ПрочитатьJSONСтроку(Задание.result);
		Исключение
			Продолжить;
		КонецПопытки;
		Если CTB_Получить(Ответ, "status", "") <> "uia-response" Тогда
			Продолжить;
		КонецЕсли;
		Если CTB_Получить(Ответ, "requestId", "") <> ИдентификаторЗапроса Тогда
			Продолжить;
		КонецЕсли;
		Если CTB_Получить(Ответ, "ok", Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
		Ошибки.Добавить("uia.typeText: " + Строка(CTB_Получить(Ответ, "error", "failed")));
		Возврат Ложь;
	КонецЦикла;
	Ошибки.Добавить("uia.typeText: response timeout");
	Возврат Ложь;
КонецФункции

Функция CTB_БезопасноеИмяЭлемента(Элемент)
	Попытка
		Возврат Элемент.Имя;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция CTB_БезопасныйЗаголовокЭлемента(Элемент)
	Попытка
		Возврат Элемент.Заголовок;
	Исключение
		Попытка
			Возврат Элемент.ТекстЗаголовка;
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

Функция CTB_ОписаниеФормыСТаймаутом(ОписаниеФормы, Таймаут)
	Результат = Новый Структура;
	Результат.Вставить("title", CTB_Получить(ОписаниеФормы, "title", Неопределено));
	Результат.Вставить("name", CTB_Получить(ОписаниеФормы, "name", Неопределено));
	Результат.Вставить("formName", CTB_Получить(ОписаниеФормы, "formName", Неопределено));
	Результат.Вставить("timeout", Таймаут);
	Возврат Результат;
КонецФункции

Функция CTB_ПроверитьВыбраннуюСсылку(Фактическое, Шаг, СтрогоПоУмолчанию = Истина)
	Ожидаемое = CTB_Получить(Шаг, "expected", CTB_Получить(Шаг, "value", Неопределено));
	Строго = CTB_Получить(Шаг, "strict", СтрогоПоУмолчанию);
	Если Строго И Ожидаемое <> Неопределено И Фактическое <> Строка(Ожидаемое) Тогда
		ВызватьИсключение "Reference selection mismatch. Expected: " + Строка(Ожидаемое) + "; actual: " + Фактическое;
	КонецЕсли;
	Возврат Фактическое;
КонецФункции

Функция CTB_ТекстовыеЗначенияСовпадают(Фактическое, Ожидаемое)
	Если Строка(Фактическое) = Строка(Ожидаемое) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат CTB_НормализоватьЧисловойТекст(Фактическое) = CTB_НормализоватьЧисловойТекст(Ожидаемое);
КонецФункции

Функция CTB_НормализоватьЧисловойТекст(Значение)
	Результат = СокрЛП(Строка(Значение));
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, ",", ".");
	ПозицияТочки = Найти(Результат, ".");
	Если ПозицияТочки = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Пока Прав(Результат, 1) = "0" Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Если Прав(Результат, 1) = "." Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция CTB_ВыбратьСтрокуТаблицы(Таблица, Шаг)
	Если CTB_ПерейтиКСтрокеТаблицы(Таблица, Шаг) Тогда
		Таблица.Выбрать();
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция CTB_РазвернутьСтрокуДерева(Таблица, Шаг)
	Если Не CTB_ПерейтиКСтрокеТаблицы(Таблица, Шаг) Тогда
		Возврат Ложь;
	КонецЕсли;
	Таблица.Активизировать();
	ТекстОшибки = "";
	// Клавиша Right — штатное действие раскрытия текущего узла дерева.
	// Используем её вместо координат/клика по глифу, чтобы сценарий переживал
	// масштабирование и смену темы клиента.
	ОшибкиUIA = Новый Массив;
	Если CTB_ЗапроситьUIAКлавишу(CTB_ТекущийТестКлиент, "right", ОшибкиUIA) Тогда
		Возврат Истина;
	КонецЕсли;
	ВызватьИсключение "Tree row could not be expanded: " + CTB_СоединитьСтроки(ОшибкиUIA, "; ");
КонецФункции

Функция CTB_ЗапроситьUIAКлавишу(ТестКлиент, Клавиша, Ошибки)
	Если ПустаяСтрока(CTB_ТекущийИдентификаторЗадания) Тогда
		Ошибки.Добавить("uia.pressKey: bridge job is not available"); Возврат Ложь;
	КонецЕсли;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Запрос = Новый Структура("status,requestId,action,key", "uia-request", ИдентификаторЗапроса, "pressKey", Клавиша);
	CodexUIJobsServer.СохранитьРезультат(CTB_ТекущийИдентификаторЗадания, CTB_ЗаписатьJSONСтроку(Запрос), "uia-request");
	// Worker polls UIA requests once per second; ten TestClient waits leave room
	// for a busy hidden desktop without allowing an input bridge to stall a run.
	Для НомерПопытки = 1 По 10 Цикл
		CTB_ПаузаТестКлиента(ТестКлиент);
		Задание = CodexUIJobsServer.ПолучитьЗадание(CTB_ТекущийИдентификаторЗадания);
		Если Задание = Неопределено Или ПустаяСтрока(Задание.result) Тогда Продолжить; КонецЕсли;
		Попытка Ответ = CTB_ПрочитатьJSONСтроку(Задание.result); Исключение Продолжить; КонецПопытки;
		Если CTB_Получить(Ответ, "status", "") <> "uia-response" Или CTB_Получить(Ответ, "requestId", "") <> ИдентификаторЗапроса Тогда Продолжить; КонецЕсли;
		Если CTB_Получить(Ответ, "ok", Ложь) Тогда Возврат Истина; КонецЕсли;
		Ошибки.Добавить("uia.pressKey: " + Строка(CTB_Получить(Ответ, "error", "failed"))); Возврат Ложь;
	КонецЦикла;
	Ошибки.Добавить("uia.pressKey: response timeout"); Возврат Ложь;
КонецФункции

Функция CTB_ПерейтиКСтрокеТаблицы(Таблица, Шаг, ВызыватьИсключение = Истина)
	ОписаниеСтрокиJSON = CTB_ОбязательноеПоле(Шаг, "row");
	ОписаниеСтроки = Новый Соответствие;
	Для Каждого ПолеСтроки Из ОписаниеСтрокиJSON Цикл
		ОписаниеСтроки.Вставить(ПолеСтроки.Ключ, ПолеСтроки.Значение);
	КонецЦикла;

	Направление = НРег(CTB_Получить(Шаг, "direction", "both"));
	Если Направление <> "up" И Направление <> "down" И Направление <> "both" Тогда
		ВызватьИсключение "Unsupported table direction: " + Направление;
	КонецЕсли;
	КоличествоПопыток = Число(CTB_Получить(Шаг, "attempts", 5));
	Родители = CTB_Получить(Шаг, "expandParents", Неопределено);
	Если Родители <> Неопределено Тогда
		Для Каждого ОписаниеРодителя Из Родители Цикл
			ШагРодителя = Новый Структура("row,direction,attempts", ОписаниеРодителя, Направление, КоличествоПопыток);
			CTB_РазвернутьСтрокуДерева(Таблица, ШагРодителя);
		КонецЦикла;
	КонецЕсли;
	Для НомерПопытки = 1 По КоличествоПопыток Цикл
		ПолучилосьПерейти = Ложь;
		Попытка
			Таблица.Активизировать();
		Исключение
		КонецПопытки;
		Если Направление = "down" Или Направление = "both" Тогда
			Попытка
				ПолучилосьПерейти = Таблица.ПерейтиКСтроке(ОписаниеСтроки, Вычислить("НаправлениеПереходаКСтроке.Вниз"));
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если Не ПолучилосьПерейти И (Направление = "up" Или Направление = "both") Тогда
			Попытка
				ПолучилосьПерейти = Таблица.ПерейтиКСтроке(ОписаниеСтроки, Вычислить("НаправлениеПереходаКСтроке.Вверх"));
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ПолучилосьПерейти Тогда
			Возврат Истина;
		КонецЕсли;
		Попытка
			Таблица.ПерейтиКПервойСтроке();
		Исключение
		КонецПопытки;
	КонецЦикла;
	Если ВызыватьИсключение Тогда
		ВызватьИсключение "Table row was not found after " + КоличествоПопыток + " attempts";
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция CTB_ИмяТипаЭлемента(Вид)
	ВидНРег = НРег(Вид);
	Если ВидНРег = "field" Тогда
		Возврат "ТестируемоеПолеФормы";
	ИначеЕсли ВидНРег = "button" Тогда
		Возврат "ТестируемаяКнопкаФормы";
	ИначеЕсли ВидНРег = "table" Тогда
		Возврат "ТестируемаяТаблицаФормы";
	ИначеЕсли ВидНРег = "group" Тогда
		Возврат "ТестируемаяГруппаФормы";
	ИначеЕсли ВидНРег = "decoration" Тогда
		Возврат "ТестируемаяДекорацияФормы";
	ИначеЕсли ВидНРег = "addition" Тогда
		Возврат "ТестируемоеДополнениеЭлементаФормы";
	КонецЕсли;
	ВызватьИсключение "Unsupported element type: " + Вид;
КонецФункции

Функция CTB_ПолучитьЭлемент(Форма, Шаг)
	ИмяТипа = CTB_ИмяТипаЭлемента(CTB_Получить(Шаг, "elementType", "field"));
	Возврат CTB_НайтиОбъект(Форма, ИмяТипа, CTB_Получить(Шаг, "element", Шаг));
КонецФункции

Функция CTB_ПопробоватьПолучитьЭлемент(Форма, Шаг)
	Попытка
		Описание = CTB_Получить(Шаг, "element", Шаг);
		КритерийЗаголовка = CTB_Получить(Описание, "title", Неопределено);
		КритерийИмени = CTB_Получить(Описание, "objectName", Неопределено);
		Возврат Форма.НайтиОбъект(Тип(CTB_ИмяТипаЭлемента(CTB_Получить(Шаг, "elementType", "field"))), КритерийЗаголовка, КритерийИмени, 1);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция CTB_ОписатьСостояниеЭлемента(Элемент)
	Состояние = Новый Структура("exists", Элемент <> Неопределено);
	Если Элемент = Неопределено Тогда
		Возврат Состояние;
	КонецЕсли;
	Попытка Состояние.Вставить("name", Элемент.Имя); Исключение КонецПопытки;
	Попытка Состояние.Вставить("title", Элемент.ТекстЗаголовка); Исключение КонецПопытки;
	Попытка Состояние.Вставить("visible", Элемент.ТекущаяВидимость()); Исключение КонецПопытки;
	Попытка Состояние.Вставить("enabled", Элемент.ТекущаяДоступность()); Исключение КонецПопытки;
	Попытка Состояние.Вставить("readOnly", Элемент.ТекущееТолькоПросмотр()); Исключение КонецПопытки;
	Попытка Состояние.Вставить("dataRepresentation", Элемент.ПолучитьПредставлениеДанных()); Исключение КонецПопытки;
	Попытка Состояние.Вставить("editText", Элемент.ПолучитьТекстРедактирования()); Исключение КонецПопытки;
	Возврат Состояние;
КонецФункции

Процедура CTB_ПроверитьДоступностьПоляДляВвода(Поле)
	Состояние = CTB_ОписатьСостояниеЭлемента(Поле);
	Если CTB_Получить(Состояние, "enabled", Неопределено) = Ложь
		Или CTB_Получить(Состояние, "readOnly", Неопределено) = Истина Тогда
		ВызватьИсключение "InputText target is not editable: " + CTB_ЗаписатьJSONСтроку(Состояние);
	КонецЕсли;
КонецПроцедуры

Функция CTB_СостояниеЭлементаСоответствует(Состояние, Шаг)
	ОжидаетсяНаличие = CTB_Получить(Шаг, "exists", Истина);
	Если CTB_Получить(Состояние, "exists", Ложь) <> ОжидаетсяНаличие Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ОжидаетсяНаличие Тогда
		Возврат Истина;
	КонецЕсли;
	ПроверяемыеСвойства = Новый Массив;
	ПроверяемыеСвойства.Добавить("visible");
	ПроверяемыеСвойства.Добавить("enabled");
	ПроверяемыеСвойства.Добавить("readOnly");
	Для Каждого ИмяСвойства Из ПроверяемыеСвойства Цикл
		Ожидаемое = CTB_Получить(Шаг, ИмяСвойства, Неопределено);
		Если Ожидаемое <> Неопределено Тогда
			Фактическое = CTB_Получить(Состояние, ИмяСвойства, Неопределено);
			Если Фактическое = Неопределено Или Фактическое <> Ожидаемое Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция CTB_ПроверитьЭлемент(Форма, Шаг)
	Элемент = CTB_ПопробоватьПолучитьЭлемент(Форма, Шаг);
	Состояние = CTB_ОписатьСостояниеЭлемента(Элемент);
	Если Не CTB_СостояниеЭлементаСоответствует(Состояние, Шаг) Тогда
		ВызватьИсключение "Element assertion failed: " + CTB_ЗаписатьJSONСтроку(Состояние);
	КонецЕсли;
	Возврат Состояние;
КонецФункции

Функция CTB_ОжидатьЭлемент(ТестКлиент, Форма, Шаг)
	МоментОкончания = ТекущаяДата() + CTB_Таймаут(Шаг);
	Пока ТекущаяДата() <= МоментОкончания Цикл
		Элемент = CTB_ПопробоватьПолучитьЭлемент(Форма, Шаг);
		Состояние = CTB_ОписатьСостояниеЭлемента(Элемент);
		Если CTB_СостояниеЭлементаСоответствует(Состояние, Шаг) Тогда
			Возврат Состояние;
		КонецЕсли;
		CTB_ПаузаТестКлиента(ТестКлиент);
	КонецЦикла;
	ВызватьИсключение "Element state was not reached: " + CTB_ЗаписатьJSONСтроку(Состояние);
КонецФункции

Процедура CTB_ПаузаТестКлиента(ТестКлиент)
	Попытка
		ТестКлиент.НайтиОбъект(Тип("ТестируемаяФорма"), "__CTB_WAIT_NEVER__", "__CTB_WAIT_NEVER__", 1);
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция CTB_ФормаОткрыта(ТестКлиент, ИскомаяФорма)
	Попытка
		Окна = ТестКлиент.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
		Для Каждого Окно Из Окна Цикл
			Попытка
				Формы = Окно.НайтиОбъекты(Тип("ТестируемаяФорма"));
				Для Каждого Форма Из Формы Цикл
					Если Форма = ИскомаяФорма Тогда
						Возврат Истина;
					КонецЕсли;
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция CTB_ОжидатьЗакрытияФормы(ТестКлиент, Форма, Шаг)
	МоментОкончания = ТекущаяДата() + CTB_Таймаут(Шаг);
	Пока ТекущаяДата() <= МоментОкончания Цикл
		Если Не CTB_ФормаОткрыта(ТестКлиент, Форма) Тогда
			Возврат Истина;
		КонецЕсли;
		CTB_ПаузаТестКлиента(ТестКлиент);
	КонецЦикла;
	ВызватьИсключение "Form was not closed within timeout";
КонецФункции

Функция CTB_НайтиФормуДиалога(ТестКлиент, Шаг, Таймаут, Обязательный = Истина)
	МоментОкончания = ТекущаяДата() + Таймаут;
	Пока ТекущаяДата() <= МоментОкончания Цикл
		Попытка
			Окно = ТестКлиент.ПолучитьАктивноеОкно();
			Если Окно <> Неопределено И Не Окно.Основное Тогда
				Формы = Окно.НайтиОбъекты(Тип("ТестируемаяФорма"));
				Для Каждого Форма Из Формы Цикл
					Если CTB_ДиалогСоответствует(Окно, Форма, Шаг) Тогда
						Возврат Форма;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Исключение
		КонецПопытки;
		CTB_ПаузаТестКлиента(ТестКлиент);
	КонецЦикла;
	Если Обязательный Тогда
		ВызватьИсключение "Modal dialog was not found";
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция CTB_ДиалогСоответствует(Окно, Форма, Шаг)
	ОжидаемыйЗаголовок = CTB_Получить(Шаг, "dialogTitle", "");
	Если Не ПустаяСтрока(ОжидаемыйЗаголовок) Тогда
		ЗаголовокОкна = "";
		ЗаголовокФормы = "";
		Попытка ЗаголовокОкна = Окно.Заголовок; Исключение КонецПопытки;
		Попытка ЗаголовокФормы = Форма.ТекстЗаголовка; Исключение КонецПопытки;
		Если СтрНайти(ЗаголовокОкна, ОжидаемыйЗаголовок) = 0 И СтрНайти(ЗаголовокФормы, ОжидаемыйЗаголовок) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ИмяФормы = CTB_ИмяФормы(Форма);
	Возврат ПустаяСтрока(ИмяФормы)
		Или ИмяФормы = "MessageBox"
		Или ИмяФормы = "ErrorWindow"
		Или ИмяФормы = "ОбщаяФорма.Вопрос"
		Или Не ПустаяСтрока(ОжидаемыйЗаголовок);
КонецФункции

Функция CTB_НормализоватьОписаниеКнопки(Описание, Таймаут)
	Если ТипЗнч(Описание) = Тип("Строка") Тогда
		Возврат Новый Структура("title,timeout", Описание, Таймаут);
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция CTB_НайтиКнопкуДиалога(ТестКлиент, ФормаДиалога, ОписаниеКнопки)
	// Обычная управляемая форма хранит кнопки в форме. У системного MessageBox
	// платформа может отдать их дочерними объектами активного окна либо его
	// командного интерфейса, поэтому все контейнеры проверяются одинаково.
	Попытка
		Возврат CTB_НайтиОбъект(ФормаДиалога, "ТестируемаяКнопкаФормы", ОписаниеКнопки);
	Исключение
	КонецПопытки;
	Попытка
		Окно = CTB_АктивноеОкно(ТестКлиент, ОписаниеКнопки);
		Возврат CTB_НайтиОбъект(Окно, "ТестируемаяКнопкаФормы", ОписаниеКнопки);
	Исключение
	КонецПопытки;
	Попытка
		Интерфейс = Окно.ПолучитьКомандныйИнтерфейс();
		Возврат CTB_НайтиОбъект(Интерфейс, "ТестируемаяКнопкаКомандногоИнтерфейса", ОписаниеКнопки);
	Исключение
	КонецПопытки;
	ВызватьИсключение "Dialog button was not found in form, window, or command interface";
КонецФункции

Функция CTB_НажатьКнопкуДиалога(ТестКлиент, ФормаДиалога, ОписаниеКнопки, Таймаут)
	ОписаниеКнопки = CTB_НормализоватьОписаниеКнопки(ОписаниеКнопки, Таймаут);
	Кнопка = CTB_НайтиКнопкуДиалога(ТестКлиент, ФормаДиалога, ОписаниеКнопки);
	Кнопка.Нажать();
	Попытка
		Возврат Кнопка.ТекстЗаголовка;
	Исключение
		Возврат "clicked";
	КонецПопытки;
КонецФункции

Функция CTB_УбратьСтартовыеДиалоги(ТестКлиент, Сценарий)
	ДопустимыеКнопки = CTB_Получить(Сценарий, "startupDialogButtons", Неопределено);
	Если ДопустимыеКнопки = Неопределено Тогда
		ДопустимыеКнопки = Новый Массив;
		ДопустимыеКнопки.Добавить("Продолжить");
		ДопустимыеКнопки.Добавить("Continue");
		ДопустимыеКнопки.Добавить("ОК");
		ДопустимыеКнопки.Добавить("OK");
		ДопустимыеКнопки.Добавить("Закрыть");
		ДопустимыеКнопки.Добавить("Close");
		ДопустимыеКнопки.Добавить("Пропустить");
		ДопустимыеКнопки.Добавить("Skip");
		ДопустимыеКнопки.Добавить("Позже");
		ДопустимыеКнопки.Добавить("Later");
		ДопустимыеКнопки.Добавить("Отмена");
		ДопустимыеКнопки.Добавить("Cancel");
	КонецЕсли;
	МаксимумДиалогов = Число(CTB_Получить(Сценарий, "startupDialogAttempts", 5));
	Результат = Новый Массив;
	Для НомерДиалога = 1 По МаксимумДиалогов Цикл
		ФормаДиалога = CTB_НайтиФормуДиалога(ТестКлиент, Новый Структура, 1, Ложь);
		Если ФормаДиалога = Неопределено Тогда
			Прервать;
		КонецЕсли;
		КнопкаНажата = Ложь;
		Если CTB_Получить(Сценарий, "restartTestClientOnStartup", Ложь) Тогда
			КнопкаПерезапуска = CTB_НайтиКнопкуБезопасногоПерезапуска(ФормаДиалога);
			Если КнопкаПерезапуска <> Неопределено Тогда
				CTB_ЗапроситьПерезапускТестКлиента();
				// Штатный обработчик сохраняет дополнительные параметры командной строки,
				// с которыми конфигурация должна продолжить запуск после перезапуска.
				КнопкаПерезапуска.Нажать();
				Результат.Добавить("restartTestClient");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Попытка
			Кнопки = ФормаДиалога.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы"));
			Для Каждого Кнопка Из Кнопки Цикл
				ЗаголовокКнопки = "";
				Попытка ЗаголовокКнопки = Кнопка.ТекстЗаголовка; Исключение КонецПопытки;
				Если ДопустимыеКнопки.Найти(ЗаголовокКнопки) <> Неопределено Тогда
					Кнопка.Нажать();
					Результат.Добавить(ЗаголовокКнопки);
					КнопкаНажата = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
		Если Не КнопкаНажата Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция CTB_ЗапроситьПерезапускТестКлиента()
	Если ПустаяСтрока(CTB_ТекущийИдентификаторЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Структура;
	Запрос.Вставить("ok", Истина);
	Запрос.Вставить("status", "client-restart-request");
	Запрос.Вставить("requestId", Строка(Новый УникальныйИдентификатор));
	Попытка
		CodexUIJobsServer.СохранитьРезультат(
			CTB_ТекущийИдентификаторЗадания,
			CTB_ЗаписатьJSONСтроку(Запрос),
			"client-restart-request");
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция CTB_НайтиКнопкуБезопасногоПерезапуска(ФормаДиалога)
	Если CTB_ИмяФормы(ФормаДиалога) <> "ОбщаяФорма.Вопрос" Тогда
		Возврат Неопределено;
	КонецЕсли;
	КнопкаПерезапуска = Неопределено;
	ЕстьЗавершениеРаботы = Ложь;
	Попытка
		Кнопки = ФормаДиалога.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы"));
		Для Каждого Кнопка Из Кнопки Цикл
			Заголовок = "";
			Попытка Заголовок = СокрЛП(Строка(Кнопка.ТекстЗаголовка)); Исключение КонецПопытки;
			НормализованныйЗаголовок = НРег(Заголовок);
			Если Лев(НормализованныйЗаголовок, СтрДлина("перезапустить")) = "перезапустить"
				Или Лев(НормализованныйЗаголовок, СтрДлина("restart")) = "restart" Тогда
				КнопкаПерезапуска = Кнопка;
			ИначеЕсли НормализованныйЗаголовок = "завершить работу"
				Или НормализованныйЗаголовок = "exit" Тогда
				ЕстьЗавершениеРаботы = Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	// Комбинация Restart + Exit отличает обязательный системный restart от
	// прикладных подтверждений, поэтому произвольная ОбщаяФорма.Вопрос не нажмётся.
	Возврат ?(КнопкаПерезапуска <> Неопределено И ЕстьЗавершениеРаботы, КнопкаПерезапуска, Неопределено);
КонецФункции

Функция CTB_ОбработатьДиалог(ТестКлиент, Шаг)
	Обязательный = Не CTB_Получить(Шаг, "optional", Ложь);
	ФормаДиалога = CTB_НайтиФормуДиалога(ТестКлиент, Шаг, CTB_Таймаут(Шаг), Обязательный);
	Если ФормаДиалога = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОписаниеКнопки = CTB_Получить(Шаг, "dialogButton", CTB_Получить(Шаг, "button", Неопределено));
	Если ОписаниеКнопки = Неопределено Тогда
		ВызватьИсключение "dialogButton is required";
	КонецЕсли;
	Возврат CTB_НажатьКнопкуДиалога(ТестКлиент, ФормаДиалога, ОписаниеКнопки, CTB_Таймаут(Шаг));
КонецФункции

Функция CTB_ОбработатьДиалогЗакрытия(ТестКлиент, Шаг)
	ФормаДиалога = CTB_НайтиФормуДиалога(ТестКлиент, Шаг, Число(CTB_Получить(Шаг, "promptTimeout", 3)), Ложь);
	Если ФормаДиалога = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОписаниеКнопки = CTB_Получить(Шаг, "dialogButton", Неопределено);
	Если ОписаниеКнопки <> Неопределено Тогда
		Возврат CTB_НажатьКнопкуДиалога(ТестКлиент, ФормаДиалога, ОписаниеКнопки, 1);
	КонецЕсли;
	ВызватьИсключение "Close prompt requires explicit dialogButton; automatic Yes/No selection is disabled";
КонецФункции

Функция CTB_АктивноеОкно(ТестКлиент, Описание)
	Окно = ТестКлиент.ПолучитьАктивноеОкно();
	Если Окно = Неопределено Тогда
		Окно = ТестКлиент.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"),,, CTB_Таймаут(Описание));
	КонецЕсли;
	Если Окно = Неопределено Тогда
		ВызватьИсключение "Active client window was not found";
	КонецЕсли;
	Возврат Окно;
КонецФункции

Функция CTB_ОписатьДеревоUI(Корень, Глубина)
	Результат = Новый Массив;
	CTB_ДобавитьОбъектыUI(Корень, Результат, 0, Число(Глубина));
	Возврат Результат;
КонецФункции

Процедура CTB_ДобавитьОбъектыUI(Родитель, Результат, Уровень, МаксимальнаяГлубина)
	Если Уровень >= МаксимальнаяГлубина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		// Для управляемых форм платформа отдаёт дерево через подчинённые объекты.
		Дочерние = Родитель.ПолучитьПодчиненныеОбъекты();
	Исключение
		// Совместимость с объектами платформы, где доступно старое имя метода.
		Попытка
			Дочерние = Родитель.ПолучитьДочерниеОбъекты();
		Исключение
			Возврат;
		КонецПопытки;
	КонецПопытки;
	Для Каждого ОбъектUI Из Дочерние Цикл
		Описание = Новый Структура;
		Описание.Вставить("level", Уровень + 1);
		Описание.Вставить("type", Строка(ТипЗнч(ОбъектUI)));
		Попытка
			Описание.Вставить("name", ОбъектUI.Имя);
		Исключение
		КонецПопытки;
		Попытка
			Описание.Вставить("title", ОбъектUI.ТекстЗаголовка);
		Исключение
		КонецПопытки;
		Попытка
			Описание.Вставить("formName", ОбъектUI.ИмяФормы);
		Исключение
		КонецПопытки;
		Результат.Добавить(Описание);
		CTB_ДобавитьОбъектыUI(ОбъектUI, Результат, Уровень + 1, МаксимальнаяГлубина);
	КонецЦикла;
КонецПроцедуры

Функция CTB_НайтиОбъект(Родитель, ИмяТипа, Описание)
	Заголовок = CTB_Получить(Описание, "title", "");
	Имя = CTB_Получить(Описание, "objectName", "");
	КритерийЗаголовка = ?(ПустаяСтрока(Заголовок), Неопределено, Заголовок);
	КритерийИмени = ?(ПустаяСтрока(Имя), Неопределено, Имя);
	Попытка
		Объект = Родитель.НайтиОбъект(Тип(ИмяТипа), КритерийЗаголовка, КритерийИмени, CTB_Таймаут(Описание));
	Исключение
		Объект = Неопределено;
	КонецПопытки;
	// Заголовки типовых конфигураций нередко отличаются регистром, неразрывными
	// пробелами или добавленным платформой пробелом. После строгого поиска
	// допускаем только однозначное нормализованное совпадение.
	Если Объект = Неопределено И (Не ПустаяСтрока(Заголовок) Или Не ПустаяСтрока(Имя)) Тогда
		Кандидаты = Новый Массив;
		CTB_СобратьКандидатыUI(Родитель, ИмяТипа, Заголовок, Имя, Кандидаты, 0, 8);
		Если Кандидаты.Количество() = 1 Тогда
			Объект = Кандидаты[0].object;
		ИначеЕсли Кандидаты.Количество() > 1 Тогда
			ОписанияКандидатов = Новый Массив;
			Для Каждого Кандидат Из Кандидаты Цикл
				ОписанияКандидатов.Добавить("name='" + Кандидат.name + "', title='" + Кандидат.title + "'");
			КонецЦикла;
			ВызватьИсключение "Ambiguous normalized UI selector. Type: " + ИмяТипа + "; candidates: " + СтрСоединить(ОписанияКандидатов, "; ");
		КонецЕсли;
	КонецЕсли;
	Если Объект = Неопределено Тогда
		ВызватьИсключение "UI object was not found. Type: " + ИмяТипа + "; title: " + Заголовок + "; name: " + Имя + ". Run inspectUi and prefer objectName.";
	КонецЕсли;
	Возврат Объект;
КонецФункции

Процедура CTB_СобратьКандидатыUI(Родитель, ИмяТипа, Заголовок, Имя, Результат, Уровень, МаксимальнаяГлубина)
	Если Уровень >= МаксимальнаяГлубина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Дочерние = Родитель.ПолучитьПодчиненныеОбъекты();
	Исключение
		Попытка
			Дочерние = Родитель.ПолучитьДочерниеОбъекты();
		Исключение
			Возврат;
		КонецПопытки;
	КонецПопытки;
	Для Каждого ОбъектUI Из Дочерние Цикл
		Если Строка(ТипЗнч(ОбъектUI)) = ИмяТипа Тогда
			ИмяОбъекта = "";
			ЗаголовокОбъекта = "";
			Попытка ИмяОбъекта = Строка(ОбъектUI.Имя); Исключение КонецПопытки;
			Попытка ЗаголовокОбъекта = Строка(ОбъектUI.ТекстЗаголовка); Исключение КонецПопытки;
			ИмяСовпало = ПустаяСтрока(Имя) Или CTB_НормализоватьUIТекст(ИмяОбъекта) = CTB_НормализоватьUIТекст(Имя);
			ЗаголовокСовпал = ПустаяСтрока(Заголовок) Или CTB_НормализоватьUIТекст(ЗаголовокОбъекта) = CTB_НормализоватьUIТекст(Заголовок);
			Если ИмяСовпало И ЗаголовокСовпал Тогда
				Результат.Добавить(Новый Структура("object,name,title", ОбъектUI, ИмяОбъекта, ЗаголовокОбъекта));
			КонецЕсли;
		КонецЕсли;
		CTB_СобратьКандидатыUI(ОбъектUI, ИмяТипа, Заголовок, Имя, Результат, Уровень + 1, МаксимальнаяГлубина);
	КонецЦикла;
КонецПроцедуры

Функция CTB_НормализоватьUIТекст(Значение)
	Результат = НРег(СокрЛП(СтрЗаменить(Строка(Значение), Символ(160), " ")));
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура CTB_СохранитьОбъект(Шаг, Объект, СохраненныеОбъекты)
	Псевдоним = CTB_Получить(Шаг, "saveAs", "");
	Если Не ПустаяСтрока(Псевдоним) Тогда
		СохраненныеОбъекты.Вставить(Псевдоним, Объект);
	КонецЕсли;
КонецПроцедуры

Функция CTB_Таймаут(Описание)
	Возврат Число(CTB_Получить(Описание, "timeout", 60));
КонецФункции

Функция CTB_ОбязательноеПоле(Источник, Имя)
	Значение = CTB_Получить(Источник, Имя, Неопределено);
	Если Значение = Неопределено Тогда
		ВызватьИсключение "Required scenario property: " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция CTB_РазобратьПараметрыЗапуска(СтрокаПараметров)
	Результат = Новый Структура;
	Для Каждого Фрагмент Из СтрРазделить(СтрокаПараметров, ";", Ложь) Цикл
		ПозицияРавно = СтрНайти(Фрагмент, "=");
		Если ПозицияРавно > 1 Тогда
			Имя = СокрЛП(Лев(Фрагмент, ПозицияРавно - 1));
			Значение = СокрЛП(Сред(Фрагмент, ПозицияРавно + 1));
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция CTB_ПрочитатьJSONСтроку(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	// Соответствие допускает реальные UI-заголовки в ключах (например,
	// "Таб. номер"), которые недопустимы как имена свойств Структуры.
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция CTB_ДекодироватьBase64ASCII(Значение)
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	Результат = "";
	Позиция = 1;
	Пока Позиция <= СтрДлина(Значение) Цикл
		Символ1 = Сред(Значение, Позиция, 1);
		Символ2 = Сред(Значение, Позиция + 1, 1);
		Символ3 = Сред(Значение, Позиция + 2, 1);
		Символ4 = Сред(Значение, Позиция + 3, 1);
		Значение1 = СтрНайти(Алфавит, Символ1) - 1;
		Значение2 = СтрНайти(Алфавит, Символ2) - 1;
		Если Значение1 < 0 Или Значение2 < 0 Тогда
			ВызватьИсключение "Invalid inline scenario encoding";
		КонецЕсли;
		Результат = Результат + Символ(Значение1 * 4 + Цел(Значение2 / 16));
		Если Символ3 <> "=" И Не ПустаяСтрока(Символ3) Тогда
			Значение3 = СтрНайти(Алфавит, Символ3) - 1;
			Если Значение3 < 0 Тогда
				ВызватьИсключение "Invalid inline scenario encoding";
			КонецЕсли;
			Результат = Результат + Символ((Значение2 - Цел(Значение2 / 16) * 16) * 16 + Цел(Значение3 / 4));
			Если Символ4 <> "=" И Не ПустаяСтрока(Символ4) Тогда
				Значение4 = СтрНайти(Алфавит, Символ4) - 1;
				Если Значение4 < 0 Тогда
					ВызватьИсключение "Invalid inline scenario encoding";
				КонецЕсли;
				Результат = Результат + Символ((Значение3 - Цел(Значение3 / 4) * 4) * 64 + Значение4);
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 4;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция CTB_ЗаписатьJSONСтроку(Данные) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция CTB_СоединитьСтроки(Строки, Разделитель)
	Результат = "";
	Для Каждого СтрокаТекста Из Строки Цикл
		Если ПустаяСтрока(Результат) Тогда
			Результат = СтрокаТекста;
		Иначе
			Результат = Результат + Разделитель + СтрокаТекста;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция CTB_Получить(Источник, Имя, ЗначениеПоУмолчанию = Неопределено)
	Если Источник = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Значение = Источник.Получить(Имя);
		Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);
	КонецЕсли;
	Значение = ЗначениеПоУмолчанию;
	Если Источник.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции
