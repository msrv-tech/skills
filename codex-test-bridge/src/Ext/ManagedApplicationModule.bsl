		КонецЕсли;
		Если CTB_Получить(Ответ, "requestId", "") <> ИдентификаторЗапроса Тогда
			Продолжить;
		КонецЕсли;
		Если CTB_Получить(Ответ, "ok", Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
