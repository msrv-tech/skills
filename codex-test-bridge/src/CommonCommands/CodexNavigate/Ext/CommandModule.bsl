&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ИдентификаторЗадания = CTB_ПараметрЗапуска("Job");
	Если ПустаяСтрока(ИдентификаторЗадания) Тогда
		ВызватьИсключение "CodexNavigate: Job is required in /C";
	КонецЕсли;
	Задание = CodexUIJobsServer.ПолучитьЗадание(ИдентификаторЗадания);
	Если Задание = Неопределено Или Задание.status <> "client-form-request" Тогда
		ВызватьИсключение "CodexNavigate: client-form-request is required";
	КонецЕсли;
	Попытка
		Команда = CTB_ПрочитатьJSON(Задание.result);
		ПолноеИмяФормы = Строка(CTB_ОбязательноеПоле(Команда, "formName"));
		ПараметрыОткрытия = Неопределено;
		Если CTB_Получить(Команда, "taskReferenceByUuid", Ложь) Тогда
			ПараметрыОткрытия = Новый Структура("Ключ",
				CodexUIJobsServer.ПолучитьСсылкуЗадачи(
					Строка(CTB_ОбязательноеПоле(Команда, "metadataName")),
					Строка(CTB_ОбязательноеПоле(Команда, "uuid"))));
		ИначеЕсли CTB_Получить(Команда, "persistentPayload", Ложь) Тогда
			ПараметрыОткрытия = CodexUIJobsServer.ПолучитьPayload(ИдентификаторЗадания);
		КонецЕсли;
		Если CTB_Получить(Команда, "requireFormKey", Ложь)
			И (ПараметрыОткрытия = Неопределено Или Не ЗначениеЗаполнено(ПараметрыОткрытия.Ключ)) Тогда
			ВызватьИсключение "CodexNavigate: task execution form did not receive a typed key";
		КонецЕсли;
		ОткрытьФорму(ПолноеИмяФормы, ПараметрыОткрытия);
		Ответ = Новый Структура("ok,formName", Истина, ПолноеИмяФормы);
		CodexUIJobsServer.СохранитьРезультат(ИдентификаторЗадания,
			CTB_ЗаписатьJSON(Ответ), "client-form-response");
	Исключение
		Ответ = Новый Структура("ok,error", Ложь, ОписаниеОшибки());
		CodexUIJobsServer.СохранитьРезультат(ИдентификаторЗадания,
			CTB_ЗаписатьJSON(Ответ), "client-form-response");
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция CTB_ПараметрЗапуска(Имя)
	Для Каждого Фрагмент Из СтрРазделить(ПараметрЗапуска, ";", Ложь) Цикл
		ПозицияРавно = СтрНайти(Фрагмент, "=");
		Если ПозицияРавно > 1 И СокрЛП(Лев(Фрагмент, ПозицияРавно - 1)) = Имя Тогда
			Возврат СокрЛП(Сред(Фрагмент, ПозицияРавно + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаКлиенте
Функция CTB_ПрочитатьJSON(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

&НаКлиенте
Функция CTB_Получить(СтруктураИлиСоответствие, Имя, ЗначениеПоУмолчанию = Неопределено)
	Если СтруктураИлиСоответствие = Неопределено Тогда Возврат ЗначениеПоУмолчанию; КонецЕсли;
	Значение = Неопределено;
	Если СтруктураИлиСоответствие.Свойство(Имя, Значение) Тогда Возврат Значение; КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

&НаКлиенте
Функция CTB_ОбязательноеПоле(СтруктураИлиСоответствие, Имя)
	Значение = CTB_Получить(СтруктураИлиСоответствие, Имя, Неопределено);
	Если Значение = Неопределено Тогда ВызватьИсключение "CodexNavigate: required field is missing: " + Имя; КонецЕсли;
	Возврат Значение;
КонецФункции

&НаКлиенте
Функция CTB_ЗаписатьJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции
