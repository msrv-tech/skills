КонецФункции

Функция КомандаMetadata(Данные)
	Разделы = Получить(Данные, "sections", Неопределено);
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("metadataName", Метаданные.Имя);
	Ответ.Вставить("configurationSynonym", Строка(Метаданные.Синоним));

	Если НужноВернутьРаздел(Разделы, "catalogs") Тогда
		Ответ.Вставить("catalogs", ОписанияМетаданныхКоллекции(Метаданные.Справочники));
	КонецЕсли;
	Если НужноВернутьРаздел(Разделы, "documents") Тогда
		Ответ.Вставить("documents", ОписанияМетаданныхКоллекции(Метаданные.Документы));
	КонецЕсли;
	Если НужноВернутьРаздел(Разделы, "enums") Тогда
		Ответ.Вставить("enums", ОписанияМетаданныхКоллекции(Метаданные.Перечисления));
	КонецЕсли;
	Если НужноВернутьРаздел(Разделы, "informationRegisters") Тогда
		Ответ.Вставить("informationRegisters", ОписанияМетаданныхКоллекции(Метаданные.РегистрыСведений));
	КонецЕсли;
	Если НужноВернутьРаздел(Разделы, "accumulationRegisters") Тогда
		Ответ.Вставить("accumulationRegisters", ОписанияМетаданныхКоллекции(Метаданные.РегистрыНакопления));
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция КомандаDescribe(Данные)
	МетаданныеОбъекта = ПолучитьМетаданныеОбъекта(Получить(Данные, "kind", ""), Получить(Данные, "name", ""));
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("object", ОписаниеМетаданных(МетаданныеОбъекта));
	Ответ.Вставить("attributes", ОписанияМетаданныхКоллекции(МетаданныеОбъекта.Реквизиты));
	Ответ.Вставить("tableParts", ОписаниеТабличныхЧастей(МетаданныеОбъекта));
	Возврат Ответ;
КонецФункции

Функция КомандаQuery(Данные)
	ТекстЗапроса = Строка(Получить(Данные, "text", ""));
	Лимит = Получить(Данные, "limit", 100);
	Если Лимит = Неопределено Или Лимит <= 0 Тогда
		Лимит = 100;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Параметры = Получить(Данные, "params", Неопределено);
	Если Параметры <> Неопределено Тогда
		Для каждого Параметр Из Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, ПреобразоватьЗначение(Параметр.Значение));
		КонецЦикла;
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Строки = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() И Счетчик < Лимит Цикл
		СтрокаРезультата = Новый Структура;
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			СтрокаРезультата.Вставить(ИмяКолонки, СериализоватьЗначение(Выборка[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("rows", Строки);
	Ответ.Вставить("count", Строки.Количество());
	Возврат Ответ;
КонецФункции

Функция КомандаExecuteBSL(Данные)
	Код = Строка(Получить(Данные, "code", ""));
	Если ПустаяСтрока(Код) Тогда
		ВызватьИсключение "code is required";
	КонецЕсли;

	Параметры = ПреобразоватьПараметрыВыполнения(Получить(Данные, "params", Неопределено));
	РезультатВыполнения = Неопределено;

	Выполнить(Код);

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("result", СериализоватьРезультат(РезультатВыполнения));
	Возврат Ответ;
КонецФункции

Функция КомандаCallCommonModule(Данные)
	ИмяМодуля = Строка(Получить(Данные, "module", Получить(Данные, "moduleName", "")));
	ИмяМетода = Строка(Получить(Данные, "method", Получить(Данные, "methodName", "")));
	Если Не ДопустимоеИмя(ИмяМодуля) Тогда
		ВызватьИсключение "Invalid common module name: " + ИмяМодуля;
	КонецЕсли;
	Если Не ДопустимоеИмя(ИмяМетода) Тогда
		ВызватьИсключение "Invalid method name: " + ИмяМетода;
	КонецЕсли;

	Параметры = ПреобразоватьПараметрыВыполнения(Получить(Данные, "params", Неопределено));
	Аргументы = "";
	Если Параметры.Количество() > 0 Тогда
		Для Индекс = 0 По Параметры.Количество() - 1 Цикл
			НомерПараметра = СокрЛП(Строка(Индекс));
			Аргументы = Аргументы + ?(Аргументы = "", "", ", ") + "Параметры[" + НомерПараметра + "]";
		КонецЦикла;
	КонецЕсли;

	Если Получить(Данные, "expectResult", Истина) Тогда
		Код = "РезультатВыполнения = " + ИмяМодуля + "." + ИмяМетода + "(" + Аргументы + ");";
	Иначе
		Код = ИмяМодуля + "." + ИмяМетода + "(" + Аргументы + ");" + Символы.ПС
			+ "РезультатВыполнения = Неопределено;";
	КонецЕсли;

	РезультатВыполнения = Неопределено;
	Выполнить(Код);

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("module", ИмяМодуля);
	Ответ.Вставить("method", ИмяМетода);
	Ответ.Вставить("result", СериализоватьРезультат(РезультатВыполнения));
	Возврат Ответ;
КонецФункции

Функция КомандаGetObject(Данные)
	Ссылка = ПолучитьСсылкуПоОписанию(Данные);
	Объект = Ссылка.ПолучитьОбъект();
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("ref", СериализоватьЗначение(Ссылка));
	Ответ.Вставить("fields", СериализоватьПоляОбъекта(Объект));
	Если Получить(Данные, "includeTables", Истина) Тогда
		Ответ.Вставить("tables", СериализоватьТабличныеЧасти(Объект));
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция КомандаWriteObject(Данные)
	Вид = Строка(Получить(Данные, "kind", Получить(Данные, "type", "")));
	Имя = Строка(Получить(Данные, "name", Получить(Данные, "catalog", Получить(Данные, "document", ""))));
	UUID = Строка(Получить(Данные, "uuid", ""));

	Если ПустаяСтрока(UUID) Тогда
		Объект = НовыйОбъектДанных(Вид, Имя);
	Иначе
		Объект = ПолучитьСсылкуПоОписанию(Данные).ПолучитьОбъект();
	КонецЕсли;
	Если Получить(Данные, "dataExchangeLoading", Ложь) Тогда
		Объект.ОбменДанными.Загрузка = Истина;
	КонецЕсли;

	ЗаполнитьОбъектИзJSON(Объект, Получить(Данные, "fields", Неопределено));
	ЗаполнитьТабличныеЧастиИзJSON(Объект, Получить(Данные, "tables", Неопределено), Получить(Данные, "clearTables", Истина));

	Режим = НРег(Строка(Получить(Данные, "writeMode", "write")));
	Если ЭтоДокумент(Вид) И Режим = "post" Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Объект.Записать();
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("ref", СериализоватьЗначение(Объект.Ссылка));
	Возврат Ответ;
КонецФункции

Функция КомандаDeleteObject(Данные)
	Ссылка = ПолучитьСсылкуПоОписанию(Данные);
	Объект = Ссылка.ПолучитьОбъект();
	ПометкаУдаления = Получить(Данные, "deletionMark", Истина);
	Объект.УстановитьПометкуУдаления(ПометкаУдаления);
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("ref", СериализоватьЗначение(Ссылка));
	Ответ.Вставить("deletionMark", ПометкаУдаления);
	Возврат Ответ;
КонецФункции

Функция КомандаCreateCatalogItem(Данные)
	Данные.Вставить("kind", "catalog");
	Данные.Вставить("name", Получить(Данные, "catalog", ""));
