Функция HealthGET(Запрос) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("service", "CodexTestBridge");
	Результат.Вставить("metadataName", Метаданные.Имя);
	Результат.Вставить("serverTime", Строка(ТекущаяДата()));
	Возврат JSONОтвет(Результат);
КонецФункции

Функция CommandPOST(Запрос) Экспорт
	Попытка
		Данные = ПрочитатьТелоJSON(Запрос);
		Команда = НРег(Строка(Получить(Данные, "command", "")));

		Если Команда = "health" Тогда
			Возврат JSONОтвет(КомандаHealth());
		ИначеЕсли Команда = "metadata" Тогда
			Возврат JSONОтвет(КомандаMetadata(Данные));
		ИначеЕсли Команда = "describe" Тогда
			Возврат JSONОтвет(КомандаDescribe(Данные));
		ИначеЕсли Команда = "query" Тогда
			Возврат JSONОтвет(КомандаQuery(Данные));
		ИначеЕсли Команда = "executebsl" Тогда
			Возврат JSONОтвет(КомандаExecuteBSL(Данные));
		ИначеЕсли Команда = "callcommonmodule" Тогда
			Возврат JSONОтвет(КомандаCallCommonModule(Данные));
		ИначеЕсли Команда = "getobject" Тогда
			Возврат JSONОтвет(КомандаGetObject(Данные));
		ИначеЕсли Команда = "writeobject" Тогда
			Возврат JSONОтвет(КомандаWriteObject(Данные));
		ИначеЕсли Команда = "deleteobject" Тогда
			Возврат JSONОтвет(КомандаDeleteObject(Данные));
		ИначеЕсли Команда = "createcatalogitem" Тогда
			Возврат JSONОтвет(КомандаCreateCatalogItem(Данные));
		ИначеЕсли Команда = "createdocument" Тогда
			Возврат JSONОтвет(КомандаCreateDocument(Данные));
		ИначеЕсли Команда = "postdocument" Тогда
			Возврат JSONОтвет(КомандаPostDocument(Данные));
		ИначеЕсли Команда = "renderexternalprintform" Тогда
			Возврат JSONОтвет(КомандаRenderExternalPrintForm(Данные));
		ИначеЕсли Команда = "renderexternalreport" Тогда
			Возврат JSONОтвет(КомандаRenderExternalReport(Данные));
		ИначеЕсли Команда = "uijobcreate" Тогда
			Возврат JSONОтвет(КомандаUIJobCreate(Данные));
		ИначеЕсли Команда = "uijobget" Тогда
			Возврат JSONОтвет(КомандаUIJobGet(Данные));
		ИначеЕсли Команда = "uijobdelete" Тогда
			Возврат JSONОтвет(КомандаUIJobDelete(Данные));
		Иначе
			Возврат ОшибкаJSON(400, "Unknown command: " + Строка(Получить(Данные, "command", "")));
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(500, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция КомандаUIJobCreate(Данные)
	Идентификатор = Строка(Получить(Данные, "jobId", ""));
	Сценарий = Строка(Получить(Данные, "scenario", ""));
	Если ПустаяСтрока(Идентификатор) Или ПустаяСтрока(Сценарий) Тогда
		ВызватьИсключение "uiJobCreate requires jobId and scenario";
	КонецЕсли;
	Возврат CodexUIJobsServer.СоздатьЗадание(Идентификатор, Сценарий);
КонецФункции

Функция КомандаUIJobGet(Данные)
	Идентификатор = Строка(Получить(Данные, "jobId", ""));
	Если ПустаяСтрока(Идентификатор) Тогда
		ВызватьИсключение "uiJobGet requires jobId";
	КонецЕсли;
	Задание = CodexUIJobsServer.ПолучитьЗадание(Идентификатор);
	Если Задание = Неопределено Тогда
		ВызватьИсключение "Codex UI job was not found: " + Идентификатор;
	КонецЕсли;
	Возврат Задание;
КонецФункции

Функция КомандаUIJobDelete(Данные)
	Идентификатор = Строка(Получить(Данные, "jobId", ""));
	Если ПустаяСтрока(Идентификатор) Тогда
		ВызватьИсключение "uiJobDelete requires jobId";
	КонецЕсли;
	CodexUIJobsServer.УдалитьЗадание(Идентификатор);
	Возврат Новый Структура("ok,jobId", Истина, Идентификатор);
КонецФункции

Функция КомандаHealth()
	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("service", "CodexTestBridge");
	Результат.Вставить("metadataName", Метаданные.Имя);
	Результат.Вставить("serverTime", Строка(ТекущаяДата()));
