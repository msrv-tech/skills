КонецФункции

Функция КомандаPostDocument(Данные)
	ИмяДокумента = Строка(Получить(Данные, "document", ""));
	Ссылка = ПолучитьСсылкуПоОписанию(Новый Структура("type,name,uuid", "DocumentRef", ИмяДокумента, Получить(Данные, "uuid", "")));
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Записать(РежимЗаписиДокумента.Проведение);

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("ref", СериализоватьЗначение(Объект.Ссылка));
	Возврат Ответ;
КонецФункции

Функция КомандаRenderExternalPrintForm(Данные)
	ИмяДокумента = Строка(Получить(Данные, "documentName", Получить(Данные, "document", "")));
	Если ПустаяСтрока(ИмяДокумента) Тогда
		Назначение = Строка(Получить(Данные, "assignment", ""));
		Если Лев(Назначение, СтрДлина("Документ.")) = "Документ." Тогда
			ИмяДокумента = Сред(Назначение, СтрДлина("Документ.") + 1);
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(ИмяДокумента) Тогда
		ВызватьИсключение "documentName or assignment=Документ.<Name> is required";
	КонецЕсли;
	ПутьВнешнейОбработки = Строка(Получить(Данные, "externalPath", Получить(Данные, "path", "")));
	Если Не ПустаяСтрока(ПутьВнешнейОбработки) Тогда
		ФайлВнешнейОбработки = Новый Файл(ПутьВнешнейОбработки);
		Если Не ФайлВнешнейОбработки.Существует() Тогда
			ВызватьИсключение "externalPath does not exist: " + ПутьВнешнейОбработки;
		КонецЕсли;
		МенеджерВнешнихОбработок = Вычислить("ВнешниеОбработки");
		ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
		ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
		Обработка = МенеджерВнешнихОбработок.Создать(ПутьВнешнейОбработки, Ложь, ОписаниеЗащиты);
	КонецЕсли;

	СсылкаДокумента = ПолучитьДокументДляПечати(Данные, ИмяДокумента);
	Если СсылкаДокумента = Неопределено Тогда
		ВызватьИсключение "No document found for print form: " + ИмяДокумента;
	КонецЕсли;
	Если ПутьВнешнейОбработки <> "" Тогда
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(СсылкаДокумента);
		ТабличныйДокумент = Обработка.СформироватьПечатнуюФормуДляТеста(МассивОбъектов);
	КонецЕсли;
	КаталогВывода = Строка(Получить(Данные, "outputDir", КаталогВременныхФайлов()));
	ИмяФайла = Строка(Получить(Данные, "outputName", "print-result"));
	СоздатьКаталог(КаталогВывода);
	ВыходныеФайлы = Новый Массив;
	Если ПутьВнешнейОбработки <> "" Тогда
		ВыходныеФайлы.Добавить(ЗаписатьФайлТабличногоДокумента(ТабличныйДокумент, ПутьСоединить(КаталогВывода, ИмяФайла + ".mxl"), "MXL"));
		ВыходныеФайлы.Добавить(ЗаписатьФайлТабличногоДокумента(ТабличныйДокумент, ПутьСоединить(КаталогВывода, ИмяФайла + ".html"), "HTML"));
		ВыходныеФайлы.Добавить(ЗаписатьФайлТабличногоДокумента(ТабличныйДокумент, ПутьСоединить(КаталогВывода, ИмяФайла + ".txt"), "TXT"));
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("mode", "rendered");
	Ответ.Вставить("externalPath", ПутьВнешнейОбработки);
	Ответ.Вставить("outputDir", КаталогВывода);
	Ответ.Вставить("outputs", ВыходныеФайлы);
	Ответ.Вставить("documentName", ИмяДокумента);
	Ответ.Вставить("document", СериализоватьЗначение(СсылкаДокумента));
	Возврат Ответ;
КонецФункции

Функция ПолучитьДокументДляПечати(Данные, ИмяДокумента)
	UUID = Строка(Получить(Данные, "uuid", ""));
	Если Не ПустаяСтрока(UUID) Тогда
		Возврат ПолучитьСсылкуПоОписанию(Новый Структура("type,name,uuid", "DocumentRef", ИмяДокумента, UUID));
	КонецЕсли;

	ИмяТабличнойЧасти = Строка(Получить(Данные, "tablePartName", "Товары"));
	ПерваяСсылка = Неопределено;
	ВыборкаДокументов = Документы[ИмяДокумента].Выбрать();
	Пока ВыборкаДокументов.Следующий() Цикл
		Если ПерваяСсылка = Неопределено Тогда
			ПерваяСсылка = ВыборкаДокументов.Ссылка;
		КонецЕсли;
		Если ДокументСодержитСтроки(ВыборкаДокументов.Ссылка, ИмяТабличнойЧасти) Тогда
			Возврат ВыборкаДокументов.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат ПерваяСсылка;
КонецФункции

Функция ДокументСодержитСтроки(СсылкаДокумента, ИмяТабличнойЧасти)
	Попытка
		ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
		Если Не ПустаяСтрока(ИмяТабличнойЧасти) Тогда
			Попытка
				ТабличнаяЧасть = ОбъектДокумента[ИмяТабличнойЧасти];
				Если ТабличнаяЧасть.Количество() > 0 Тогда
					Возврат Истина;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Для каждого ОписаниеТабличнойЧасти Из ОбъектДокумента.Метаданные().ТабличныеЧасти Цикл
			ТабличнаяЧасть = ОбъектДокумента[ОписаниеТабличнойЧасти.Имя];
			Если ТабличнаяЧасть.Количество() > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;

		Возврат Ложь;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция КомандаRenderExternalReport(Данные)
	ПутьВнешнегоОтчета = Строка(Получить(Данные, "externalPath", Получить(Данные, "path", "")));
	Если ПустаяСтрока(ПутьВнешнегоОтчета) Тогда
		ВызватьИсключение "externalPath is required";
	КонецЕсли;
	ФайлВнешнегоОтчета = Новый Файл(ПутьВнешнегоОтчета);
	Если Не ФайлВнешнегоОтчета.Существует() Тогда
		ВызватьИсключение "externalPath does not exist: " + ПутьВнешнегоОтчета;
	КонецЕсли;

	МенеджерВнешнихОтчетов = Вычислить("ВнешниеОтчеты");
	ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
	Отчет = МенеджерВнешнихОтчетов.Создать(ПутьВнешнегоОтчета, Ложь, ОписаниеЗащиты);

	ПараметрыОтчета = Получить(Данные, "reportParams", Получить(Данные, "params", Новый Структура));
	ТабличныйДокумент = Отчет.СформироватьОтчетДляТеста(ПараметрыОтчета);

	КаталогВывода = Строка(Получить(Данные, "outputDir", КаталогВременныхФайлов()));
	ИмяФайла = Строка(Получить(Данные, "outputName", "report-result"));
	СоздатьКаталог(КаталогВывода);
	ВыходныеФайлы = Новый Массив;
	ВыходныеФайлы.Добавить(ЗаписатьФайлТабличногоДокумента(ТабличныйДокумент, ПутьСоединить(КаталогВывода, ИмяФайла + ".mxl"), "MXL"));
	ВыходныеФайлы.Добавить(ЗаписатьФайлТабличногоДокумента(ТабличныйДокумент, ПутьСоединить(КаталогВывода, ИмяФайла + ".html"), "HTML"));
	ВыходныеФайлы.Добавить(ЗаписатьФайлТабличногоДокумента(ТабличныйДокумент, ПутьСоединить(КаталогВывода, ИмяФайла + ".txt"), "TXT"));

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Ответ.Вставить("mode", "rendered");
	Ответ.Вставить("externalPath", ПутьВнешнегоОтчета);
	Ответ.Вставить("outputDir", КаталогВывода);
	Ответ.Вставить("outputs", ВыходныеФайлы);
	Возврат Ответ;
КонецФункции

Функция ЗаписатьФайлТабличногоДокумента(ТабличныйДокумент, Путь, Формат)
	Если Формат = "MXL" Тогда
		ТабличныйДокумент.Записать(Путь, ТипФайлаТабличногоДокумента.MXL);
	ИначеЕсли Формат = "HTML" Тогда
		ТабличныйДокумент.Записать(Путь, ТипФайлаТабличногоДокумента.HTML);
	ИначеЕсли Формат = "TXT" Тогда
		ТабличныйДокумент.Записать(Путь, ТипФайлаТабличногоДокумента.TXT);
	Иначе
		ТабличныйДокумент.Записать(Путь);
	КонецЕсли;
	ФайлРезультата = Новый Файл(Путь);
	Ответ = Новый Структура;
	Ответ.Вставить("path", Путь);
	Ответ.Вставить("format", Формат);
	Ответ.Вставить("exists", ФайлРезультата.Существует());
	Возврат Ответ;
КонецФункции

Функция ПутьСоединить(Каталог, ИмяФайла)
	Если Прав(Каталог, 1) = "\" Или Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог + ИмяФайла;
	КонецЕсли;
	Возврат Каталог + "\" + ИмяФайла;
КонецФункции

Функция НовыйОбъектДанных(Вид, Имя)
	Если ЭтоСправочник(Вид) Тогда
		Возврат Справочники[Имя].СоздатьЭлемент();
	ИначеЕсли ЭтоДокумент(Вид) Тогда
		Возврат Документы[Имя].СоздатьДокумент();
	Иначе
		ВызватьИсключение "Unsupported object kind for write: " + Строка(Вид);
	КонецЕсли;
КонецФункции

Процедура ЗаполнитьОбъектИзJSON(Объект, Поля)
	Если Поля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значения = Новый Структура;
	Для каждого Поле Из Поля Цикл
		Значения.Вставить(Поле.Ключ, ПреобразоватьЗначение(Поле.Значение));
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Объект, Значения);
КонецПроцедуры

Процедура ЗаполнитьТабличныеЧастиИзJSON(Объект, Таблицы, Очистить = Истина)
	Если Таблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для каждого ТаблицаJSON Из Таблицы Цикл
		ИмяТаблицы = ТаблицаJSON.Ключ;
		ТабличнаяЧасть = Объект[ИмяТаблицы];
		Если Очистить Тогда
			ТабличнаяЧасть.Очистить();
		КонецЕсли;
		Для каждого СтрокаJSON Из ТаблицаJSON.Значение Цикл
			НоваяСтрока = ТабличнаяЧасть.Добавить();
			ЗаполнитьОбъектИзJSON(НоваяСтрока, СтрокаJSON);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ПреобразоватьЗначение(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		ТипОписания = Строка(Получить(Значение, "type", ""));
		Если ПустаяСтрока(ТипОписания) Тогда
			ТипОписания = Строка(Получить(Значение, "kind", ""));
		КонецЕсли;
		Если ТипОписания <> "" Тогда
			Если НРег(ТипОписания) = "date" Тогда
				Возврат Дата(Строка(Получить(Значение, "value", "")));
			Иначе
				Возврат ПолучитьСсылкуПоОписанию(Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Значение;
КонецФункции

Функция ПолучитьСсылкуПоОписанию(Описание)
	ТипСсылки = НРег(Строка(Получить(Описание, "type", Получить(Описание, "kind", ""))));
	Имя = Строка(Получить(Описание, "name", Получить(Описание, "catalog", Получить(Описание, "document", ""))));
	UUID = Новый УникальныйИдентификатор(Строка(Получить(Описание, "uuid", "")));

	Если ТипСсылки = "catalogref" Или ТипСсылки = "catalog" Тогда
		Возврат Справочники[Имя].ПолучитьСсылку(UUID);
	ИначеЕсли ТипСсылки = "documentref" Или ТипСсылки = "document" Тогда
		Возврат Документы[Имя].ПолучитьСсылку(UUID);
	ИначеЕсли ТипСсылки = "enumref" Или ТипСсылки = "enum" Тогда
		Возврат Перечисления[Имя].ПолучитьСсылку(UUID);
	Иначе
		ВызватьИсключение "Unsupported ref type: " + ТипСсылки;
	КонецЕсли;
КонецФункции

Функция Получить(Источник, Имя, ЗначениеПоУмолчанию = Неопределено)
	Если Источник = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Значение = ЗначениеПоУмолчанию;
		Если Источник.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ЗначениеПоУмолчанию;
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Если Источник.Получить(Имя) <> Неопределено Тогда
			Возврат Источник.Получить(Имя);
		КонецЕсли;
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ПрочитатьТелоJSON(Запрос)
	Тело = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(Тело) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

Функция JSONОтвет(Данные, КодСостояния = 200)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(КодСостояния, Сообщение)
	Данные = Новый Структура;
	Данные.Вставить("ok", Ложь);
	Данные.Вставить("error", Сообщение);
	Возврат JSONОтвет(Данные, КодСостояния);
КонецФункции

Функция НужноВернутьРаздел(Разделы, ИмяРаздела)
	Если Разделы = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ТипРазделов = ТипЗнч(Разделы);
	Если ТипРазделов = Тип("Строка") Тогда
		Для каждого Раздел Из СтрРазделить(Разделы, ",; ") Цикл
			Если НРег(СокрЛП(Раздел)) = НРег(ИмяРаздела) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Если ТипРазделов = Тип("Структура") Или ТипРазделов = Тип("Соответствие") Тогда
		Для каждого Раздел Из Разделы Цикл
			Если НРег(Строка(Раздел.Ключ)) = НРег(ИмяРаздела) И Раздел.Значение <> Ложь Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Если ТипРазделов <> Тип("Массив") Тогда
		Возврат НРег(Строка(Разделы)) = НРег(ИмяРаздела);
	КонецЕсли;

	Для каждого Раздел Из Разделы Цикл
		Если НРег(Строка(Раздел)) = НРег(ИмяРаздела) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОписанияМетаданныхКоллекции(Коллекция)
	Результат = Новый Массив;
	Для каждого ОбъектМетаданных Из Коллекция Цикл
		Результат.Добавить(ОписаниеМетаданных(ОбъектМетаданных));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОписаниеМетаданных(ОбъектМетаданных)
	Результат = Новый Структура;
	Результат.Вставить("name", ОбъектМетаданных.Имя);
	Результат.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));
	Возврат Результат;
КонецФункции

Функция ОписаниеТабличныхЧастей(МетаданныеОбъекта)
	Результат = Новый Массив;
	Для каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Описание = ОписаниеМетаданных(ТабличнаяЧасть);
		Описание.Вставить("attributes", ОписанияМетаданныхКоллекции(ТабличнаяЧасть.Реквизиты));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьМетаданныеОбъекта(Вид, Имя)
	ВидНорм = НРег(Строка(Вид));
	Если ЭтоСправочник(ВидНорм) Тогда
		Возврат Метаданные.Справочники[Имя];
	ИначеЕсли ЭтоДокумент(ВидНорм) Тогда
		Возврат Метаданные.Документы[Имя];
	ИначеЕсли ВидНорм = "enum" Или ВидНорм = "enumref" Или ВидНорм = "enumeration" Тогда
		Возврат Метаданные.Перечисления[Имя];
	Иначе
		ВызватьИсключение "Unsupported metadata kind: " + Строка(Вид);
	КонецЕсли;
КонецФункции

Функция ЭтоСправочник(Вид)
	ВидНорм = НРег(Строка(Вид));
	Возврат ВидНорм = "catalog" Или ВидНорм = "catalogref";
КонецФункции

Функция ЭтоДокумент(Вид)
	ВидНорм = НРег(Строка(Вид));
	Возврат ВидНорм = "document" Или ВидНорм = "documentref";
КонецФункции

Функция ПреобразоватьПараметрыВыполнения(ПараметрыJSON)
	Параметры = Новый Массив;
	Если ПараметрыJSON = Неопределено Тогда
		Возврат Параметры;
	КонецЕсли;

	Если ТипЗнч(ПараметрыJSON) = Тип("Массив") Тогда
		Для каждого ПараметрJSON Из ПараметрыJSON Цикл
			Параметры.Добавить(ПреобразоватьЗначение(ПараметрJSON));
		КонецЦикла;
	Иначе
		Параметры.Добавить(ПреобразоватьЗначение(ПараметрыJSON));
	КонецЕсли;

	Возврат Параметры;
КонецФункции

Функция ДопустимоеИмя(Имя)
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗапрещенныеСимволы = " .,;:()[]{}+-*/\|&=<>!?""'`~@#$%^№" + Символы.Таб + Символы.ПС;
	Для Индекс = 1 По СтрДлина(ЗапрещенныеСимволы) Цикл
		Если СтрНайти(Имя, Сред(ЗапрещенныеСимволы, Индекс, 1)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

Функция СериализоватьПоляОбъекта(Объект)
	Результат = Новый Структура;
	МетаданныеОбъекта = Объект.Метаданные();

	Для каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Попытка
			Результат.Вставить(Реквизит.Имя, СериализоватьЗначение(Объект[Реквизит.Имя]));
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Попытка
			Результат.Вставить(Реквизит.Имя, СериализоватьЗначение(Объект[Реквизит.Имя]));
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция СериализоватьТабличныеЧасти(Объект)
	Результат = Новый Структура;
	МетаданныеОбъекта = Объект.Метаданные();
	Для каждого ТабличнаяЧастьМетаданных Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Строки = Новый Массив;
		ТабличнаяЧасть = Объект[ТабличнаяЧастьМетаданных.Имя];
		Для каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
			СтрокаJSON = Новый Структура;
			Для каждого Реквизит Из ТабличнаяЧастьМетаданных.Реквизиты Цикл
				СтрокаJSON.Вставить(Реквизит.Имя, СериализоватьЗначение(СтрокаТаблицы[Реквизит.Имя]));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Результат.Вставить(ТабличнаяЧастьМетаданных.Имя, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СериализоватьРезультат(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, СериализоватьРезультат(Элемент.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для каждого Элемент Из Значение Цикл
			Результат.Добавить(СериализоватьРезультат(Элемент));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Массив;
		Для каждого Элемент Из Значение Цикл
			Пара = Новый Структура;
			Пара.Вставить("key", СериализоватьРезультат(Элемент.Ключ));
			Пара.Вставить("value", СериализоватьРезультат(Элемент.Значение));
			Результат.Добавить(Пара);
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый Массив;
		Для каждого СтрокаТаблицы Из Значение Цикл
			СтрокаJSON = Новый Структура;
			Для каждого Колонка Из Значение.Колонки Цикл
				СтрокаJSON.Вставить(Колонка.Имя, СериализоватьРезультат(СтрокаТаблицы[Колонка.Имя]));
			КонецЦикла;
			Результат.Добавить(СтрокаJSON);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат СериализоватьЗначение(Значение);
КонецФункции

Функция СериализоватьЗначение(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("type", Строка(ТипЗнч(Значение)));
	Результат.Вставить("presentation", Строка(Значение));

	Попытка
		Результат.Вставить("uuid", Строка(Значение.УникальныйИдентификатор()));
	Исключение
	КонецПопытки;

	Возврат Результат;
КонецФункции
