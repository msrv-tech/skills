{
  "$schema": "../../../codex-test-bridge/ui-scenario.schema.json",
  "name": "UI conformance: command interface and application commands",
  "conformanceCases": ["button.command-interface", "navigation.command"],
  "steps": [
    {"action": "inspectCommandInterface", "depth": 6},
    {"action": "clickCommandInterface", "button": {"title": "Codex UI fixture", "timeout": 15}},
    {"action": "inspectCommandInterface", "depth": 6},
    {"action": "executeCommand", "command": "e1cib/command/ОбщаяКоманда.CodexUIFixtureCommand"},
    {"action": "waitForm", "title": "Codex UI conformance", "saveAs": "fixtureByCommand", "timeout": 30},
    {"action": "assertElement", "form": "fixtureByCommand", "elementType": "field", "element": {"objectName": "Status"}, "exists": true}
  ]
}
