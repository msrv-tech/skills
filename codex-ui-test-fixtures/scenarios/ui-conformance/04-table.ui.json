{
  "$schema": "../../../codex-test-bridge/ui-scenario.schema.json",
  "name": "UI conformance: table, search addition and cell editing",
  "conformanceCases": ["table.rows", "table.selection", "table.order", "table.edit-cell", "addition.search"],
  "steps": [
    {
      "action": "openForm",
      "metadataKind": "commonForm",
      "metadataName": "CodexUIConformance",
      "targetForm": {"formName": "ОбщаяФорма.CodexUIConformance", "saveAs": "fixture", "timeout": 30}
    },
    {"action": "activateElement", "form": "fixture", "elementType": "table", "element": {"objectName": "Rows"}},
    {"action": "inspectTable", "form": "fixture", "table": {"objectName": "Rows"}},
    {"action": "assertTableRow", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "row-2"}, "exists": true},
    {"action": "assertTableRow", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "missing-row"}, "exists": false},
    {"action": "selectTableRow", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "row-2"}, "select": false},
    {"action": "selectTableRow", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "row-2"}, "select": true},
    {"action": "selectAllTableRows", "form": "fixture", "table": {"objectName": "Rows"}},
    {"action": "assertSelectedRows", "form": "fixture", "table": {"objectName": "Rows"}, "expectedCount": 3},
    {"action": "setTableOrder", "form": "fixture", "table": {"objectName": "Rows"}, "column": "Number"},
    {"action": "inputTableCell", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "row-2"}, "field": {"objectName": "RowsText"}, "value": "Beta row editing", "finishRow": false},
    {"action": "assertField", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "row-2"}, "field": {"objectName": "RowsText"}, "contains": "editing", "finishRow": false},
    {"action": "inputTableCell", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "row-2"}, "field": {"objectName": "RowsText"}, "value": "Beta row changed", "finishRow": true},
    {"action": "assertField", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Key": "row-2"}, "field": {"objectName": "RowsText"}, "expected": "Beta row changed"},
    {"action": "inputText", "form": "fixture", "elementType": "addition", "field": {"objectName": "RowsСтрокаПоиска"}, "value": "Gamma"},
    {"action": "assertTableRow", "form": "fixture", "table": {"objectName": "Rows"}, "row": {"Text": "Gamma row"}, "exists": true},
    {"action": "closeForm", "form": "fixture"}
  ]
}
