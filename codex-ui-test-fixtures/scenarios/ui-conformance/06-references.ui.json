{
  "$schema": "../../../codex-test-bridge/ui-scenario.schema.json",
  "name": "UI conformance: metadata references and choice controls",
  "conformanceCases": [
    "reference.catalog",
    "reference.document",
    "reference.characteristic",
    "reference.account",
    "reference.calculation-type",
    "reference.composite",
    "reference.table",
    "reference.choice-form-selection",
    "reference.enum",
    "reference.choice-form",
    "reference.create"
  ],
  "steps": [
    {
      "action": "openForm",
      "metadataKind": "commonForm",
      "metadataName": "CodexUIConformance",
      "targetForm": {"formName": "ОбщаяФорма.CodexUIConformance", "saveAs": "fixture", "timeout": 30}
    },
    {"action": "assertElement", "form": "fixture", "elementType": "field", "element": {"objectName": "CatalogValue"}, "exists": true, "enabled": true},
    {"action": "createReference", "form": "fixture", "field": {"objectName": "CatalogChoiceValue"}, "targetForm": {"formName": "Справочник.CodexUIFixtureCatalog.Форма.ФормаFixture", "saveAs": "createdCatalog", "timeout": 30}},
    {"action": "closeForm", "form": "createdCatalog"},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "CatalogValue"}, "strategy": "dropdownExact", "value": "Fixture catalog Alpha", "strict": true},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "CatalogValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "DocumentValue"}, "strategy": "dropdownExact", "value": "Fixture document Alpha", "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "DocumentValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "CatalogValue"}, "strategy": "typeAhead", "value": "Fixture catalog", "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "CatalogValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "DocumentValue"}, "strategy": "auto", "value": "Fixture document Alpha", "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "DocumentValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "CharacteristicValue"}, "strategy": "dropdownExact", "value": "Fixture characteristic Alpha", "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "CharacteristicValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "AccountValue"}, "strategy": "dropdownExact", "value": "Fixture account Alpha", "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "AccountValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "CalculationTypeValue"}, "strategy": "dropdownExact", "value": "Fixture calculation type Alpha", "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "CalculationTypeValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "CompositeValue"}, "strategy": "dropdownExact", "referenceType": "Codex UI fixture catalog", "value": "Fixture catalog Alpha", "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "CompositeValue"}, "notEmpty": true},
    {"action": "selectFromDropdown", "form": "fixture", "field": {"objectName": "EnumValue"}, "value": "Ready", "match": "exact"},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "EnumValue"}, "notEmpty": true},
    {"action": "selectReference", "form": "fixture", "table": {"objectName": "ReferenceRows"}, "row": {"Key": "reference-row-1"}, "field": {"objectName": "ReferenceRowsCatalogValue"}, "strategy": "dropdownExact", "value": "Fixture catalog Alpha", "strict": false, "finishRow": true},
    {"action": "assertField", "form": "fixture", "table": {"objectName": "ReferenceRows"}, "row": {"Key": "reference-row-1"}, "field": {"objectName": "ReferenceRowsCatalogValue"}, "notEmpty": true},
    {"action": "openChoice", "form": "fixture", "field": {"objectName": "CatalogChoiceValue"}, "saveAs": "catalogChoice", "choiceForm": {"title": "Codex UI fixture catalog", "metadataFullName": "Справочник.CodexUIFixtureCatalog", "timeout": 15}},
    {"action": "inspectUi", "form": "catalogChoice", "depth": 4},
    {"action": "closeForm", "form": "catalogChoice"},
    {"action": "selectReference", "form": "fixture", "field": {"objectName": "CatalogChoiceValue"}, "strategy": "choiceForm", "choiceForm": {"title": "Codex UI fixture catalog", "metadataFullName": "Справочник.CodexUIFixtureCatalog", "timeout": 15}, "table": {"objectName": "Список"}, "row": {"Наименование": "Fixture catalog Alpha"}, "strict": false},
    {"action": "assertField", "form": "fixture", "field": {"objectName": "CatalogChoiceValue"}, "notEmpty": true},
    {"action": "closeForm", "form": "fixture"}
  ]
}
