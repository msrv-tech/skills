{
  "$schema": "../../../codex-test-bridge/ui-scenario.schema.json",
  "name": "UI conformance: data processor and application windows",
  "conformanceCases": ["form.data-processor", "window.navigation"],
  "steps": [
    {
      "action": "openForm",
      "metadataKind": "commonForm",
      "metadataName": "CodexUIConformance",
      "targetForm": {"formName": "ОбщаяФорма.CodexUIConformance", "saveAs": "fixture", "timeout": 30}
    },
    {
      "action": "openDataProcessor",
      "metadataName": "CodexUIFixtureProcessor",
      "formName": "Форма",
      "targetForm": {"title": "Codex UI fixture processor", "saveAs": "processor", "timeout": 30}
    },
    {"action": "activateWindow", "timeout": 10},
    {"action": "nextWindow", "timeout": 10},
    {"action": "previousWindow", "timeout": 10},
    {"action": "activateForm", "form": "processor"},
    {"action": "assertElement", "form": "processor", "elementType": "field", "element": {"objectName": "ProcessorStatus"}, "exists": true, "visible": true},
    {"action": "closeForm", "form": "processor"},
    {"action": "closeForm", "form": "fixture"},
    {"action": "homeWindow", "timeout": 15}
  ]
}
