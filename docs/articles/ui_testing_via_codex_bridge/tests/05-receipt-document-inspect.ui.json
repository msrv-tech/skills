{
  "$schema": "../../../../codex-test-bridge/ui-scenario.schema.json",
  "name": "Открытие новой приходной накладной",
  "steps": [
    {"action": "assertConnected", "name": "Проверить соединение"},
    {"action": "handleDialog", "name": "Закрыть предупреждение безопасности", "dialogTitle": "Предупреждение безопасности", "dialogButton": "ОК", "optional": true, "timeout": 10},
    {
      "action": "openNavigationLink",
      "name": "Открыть список поступлений",
      "link": "e1cib/list/Документ.ПоступлениеТоваровУслуг",
      "attempts": 3,
      "targetForm": {"formName": "Документ.ПоступлениеТоваровУслуг.Форма.ФормаСписка", "timeout": 90, "saveAs": "receipts"}
    },
    {"action": "click", "name": "Создать поступление товаров", "form": "receipts", "button": {"objectName": "СоздатьПоступлениеТовары", "timeout": 30}},
    {"action": "waitForm", "name": "Дождаться новой приходной накладной", "formName": "Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокументаТовары", "timeout": 90, "saveAs": "receipt"},
    {"action": "inspectUi", "name": "Получить поля приходной накладной", "form": "receipt", "depth": 7, "timeout": 30},
    {"action": "closeForm", "name": "Закрыть документ без записи", "form": "receipt", "onPrompt": "discard", "timeout": 30}
  ]
}
