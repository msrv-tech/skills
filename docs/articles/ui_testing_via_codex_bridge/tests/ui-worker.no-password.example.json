{
  "backend": "windowsDesktop",
  "testHost": "127.0.0.1",
  "testPort": 1538,
  "probeTestPort": false,
  "startupDelaySeconds": 20,
  "startupTimeoutSeconds": 60,
  "timeoutSeconds": 900,
  "resultTransport": "bridgeJob",
  "captureOnFinish": true,
  "bridgeBaseUrl": "{bridgeBaseUrl}",
  "environmentPlaceholders": {
    "platformExecutable": "CODEX_1C_EXECUTABLE",
    "serverConnection": "CODEX_1C_SERVER_CONNECTION",
    "bridgeBaseUrl": "CODEX_1C_BRIDGE_URL",
    "username": "CODEX_1C_USERNAME"
  },
  "clientCommand": [
    "{platformExecutable}", "ENTERPRISE", "/S", "{serverConnection}", "/N", "{username}",
    "/DisableStartupDialogs", "/DisableStartupMessages", "/DisableSplash", "/TestClient",
    "/C", "CodexUITestClient;Job={jobId}"
  ],
  "managerCommand": [
    "{platformExecutable}", "ENTERPRISE", "/S", "{serverConnection}", "/N", "{username}",
    "/DisableStartupDialogs", "/DisableStartupMessages", "/DisableSplash", "/TestManager",
    "/C", "CodexUITest;Job={jobId};Host=127.0.0.1;Port={testPort}", "/Out", "{managerLog}"
  ]
}
