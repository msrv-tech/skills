{
  "$schema": "../../../../codex-test-bridge/ui-scenario.schema.json",
  "name": "Инспекция выбора поставщика",
  "steps": [
    {"action": "assertConnected"},
    {"action": "handleDialog", "dialogTitle": "Предупреждение безопасности", "dialogButton": "ОК", "optional": true, "timeout": 10},
    {"action": "waitForm", "formName": "Документ.ПоступлениеТоваровУслуг.Форма.ФормаСписка", "timeout": 30, "saveAs": "receipts"},
    {"action": "activateForm", "form": "receipts"},
    {"action": "click", "form": "receipts", "button": {"objectName": "СоздатьПоступлениеТовары", "timeout": 30}},
    {"action": "waitForm", "formName": "Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокументаТовары", "timeout": 90, "saveAs": "receipt"},
    {"action": "openChoice", "name": "Открыть выбор поставщика", "form": "receipt", "field": {"objectName": "Контрагент", "timeout": 30}, "choiceForm": {"title": "Контрагенты", "timeout": 30}, "saveAs": "counterparties"},
    {"action": "inspectTable", "name": "Получить поставщиков", "form": "counterparties", "table": {"objectName": "Список", "timeout": 30}, "timeout": 30}
  ]
}
