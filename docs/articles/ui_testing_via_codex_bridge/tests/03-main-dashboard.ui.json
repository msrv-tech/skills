{
  "$schema": "../../../../codex-test-bridge/ui-scenario.schema.json",
  "name": "Проверка информационной панели БП",
  "steps": [
    {
      "name": "Проверить соединение",
      "action": "assertConnected"
    },
    {
      "name": "Закрыть безопасное предупреждение при первом запуске",
      "action": "handleDialog",
      "dialogTitle": "Предупреждение безопасности",
      "dialogButton": "ОК",
      "optional": true,
      "timeout": 10
    },
    {
      "name": "Найти информационную панель",
      "action": "waitForm",
      "formName": "ОбщаяФорма.ИнформационнаяПанель",
      "saveAs": "dashboard",
      "timeout": 30
    },
    {
      "name": "Получить дерево информационной панели",
      "action": "inspectUi",
      "form": "dashboard",
      "depth": 4
    }
  ]
}
